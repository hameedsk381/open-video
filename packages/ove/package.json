{
  "name": "motionrender",
  "version": "0.5.2",
  "description": "JSON-first, frame-deterministic motion graphics video engine: render compositions to MP4, WebM, ProRes, GIF or PNG frames from Node or the command line.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "motionrender": "dist/cli.js",
    "mr": "dist/cli.js",
    "ove": "dist/cli.js"
  },
  "files": [
    "dist",
    "starter",
    "blocks",
    "themes",
    "studio",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "pg": "^8.0.0",
    "playwright": "1.64.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "motionrender",
    "motion-graphics",
    "video",
    "render",
    "remotion-alternative",
    "ffmpeg",
    "json",
    "animation",
    "canvas"
  ],
  "peerDependencies": {
    "@types/node": ">=22",
    "react": ">=18",
    "esbuild": ">=0.20"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  }
}
