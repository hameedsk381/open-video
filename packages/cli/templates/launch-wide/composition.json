{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "launch-wide",
  "name": "Launch (16:9)",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "export": {
    "format": "mp4",
    "loudness": -14
  },
  "motionBlur": {
    "samples": 4,
    "shutter": 180
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0b1020",
      "description": "Theme: bg"
    },
    "surface": {
      "type": "color",
      "default": "#151c33",
      "description": "Theme: surface"
    },
    "text": {
      "type": "color",
      "default": "#f5f7fb",
      "description": "Theme: text"
    },
    "muted": {
      "type": "color",
      "default": "#9aa6c4",
      "description": "Theme: muted"
    },
    "accent": {
      "type": "color",
      "default": "#22d3ee",
      "description": "Theme: accent"
    },
    "accent2": {
      "type": "color",
      "default": "#a78bfa",
      "description": "Theme: accent2"
    },
    "radius": {
      "type": "number",
      "default": 20,
      "description": "Theme: radius"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: headWeight"
    },
    "kicker": {
      "type": "string",
      "default": "INTRODUCING",
      "description": "Small label above the title"
    },
    "title": {
      "type": "string",
      "default": "Make something people remember",
      "description": "The big title (about 5 words)"
    },
    "subtitle": {
      "type": "string",
      "default": "One clear line about why it matters.",
      "description": "One supporting sentence"
    },
    "stat": {
      "type": "string",
      "default": "87%",
      "description": "The one number to show"
    },
    "statLabel": {
      "type": "string",
      "default": "of viewers keep watching until the end",
      "description": "What the number means"
    },
    "featuresTitle": {
      "type": "string",
      "default": "What you get",
      "description": "Heading of the list"
    },
    "features": {
      "type": "list",
      "items": {
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "default": [
        {
          "text": "Frame-exact, repeatable renders"
        },
        {
          "text": "Text that fits and reflows"
        },
        {
          "text": "Sound, captions and music in one file"
        },
        {
          "text": "Edit it all as plain JSON"
        }
      ],
      "description": "Up to six short points"
    },
    "ctaHeadline": {
      "type": "string",
      "default": "Ready to start?",
      "description": "Closing question or line"
    },
    "ctaButton": {
      "type": "string",
      "default": "Get started",
      "description": "Button text"
    },
    "url": {
      "type": "string",
      "default": "example.com",
      "description": "Web address"
    },
    "handle": {
      "type": "string",
      "default": "@yourbrand",
      "description": "Social handle shown in the corner"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Space Grotesk",
      "description": "Theme: fontDisplay"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: fontBody"
    },
    "texture": {
      "type": "string",
      "default": "grid",
      "description": "Theme: texture"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: textureColor"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.035,
      "description": "Theme: textureOpacity"
    },
    "motion": {
      "type": "string",
      "default": "blur",
      "description": "Theme: motion"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: transition"
    },
    "layout": {
      "type": "string",
      "default": "left",
      "description": "Theme: layout"
    },
    "density": {
      "type": "number",
      "default": 1,
      "description": "Theme: density"
    },
    "closeVariant": {
      "type": "string",
      "default": "panel",
      "description": "Closing layout: center, left or panel"
    },
    "heroVariant": {
      "type": "string",
      "default": "band",
      "description": "Opening layout: left, center or band"
    },
    "statVariant": {
      "type": "string",
      "default": "center",
      "description": "Stat layout: center, left or split"
    }
  },
  "scenes": [
    {
      "id": "title-hero",
      "name": "Title hero",
      "durationFrames": 150,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 150,
                "value": 1.08,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "title_hero",
          "id": "title-hero-block",
          "with": {
            "kicker": "{{kicker}}",
            "headline": "{{title}}",
            "subtitle": "{{subtitle}}",
            "variant": "{{heroVariant}}"
          }
        }
      ]
    },
    {
      "id": "big-stat",
      "name": "Big stat",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1.1
              },
              {
                "frame": 120,
                "value": 1,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "big_stat",
          "id": "big-stat-block",
          "with": {
            "value": "{{stat}}",
            "label": "{{statLabel}}",
            "variant": "{{statVariant}}"
          }
        }
      ],
      "transitionIn": {
        "type": "{{transition}}",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "feature-list",
      "name": "Feature list",
      "durationFrames": 180,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 180,
                "value": 1.04,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "feature_list",
          "id": "feature-list-block",
          "with": {
            "title": "{{featuresTitle}}",
            "items": "{{features}}"
          }
        }
      ],
      "transitionIn": {
        "type": "{{transition}}",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "cta-end",
      "name": "Call to action",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.06,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "cta_end",
          "id": "cta-end-block",
          "with": {
            "headline": "{{ctaHeadline}}",
            "button": "{{ctaButton}}",
            "url": "{{url}}",
            "variant": "{{closeVariant}}"
          }
        },
        {
          "use": "handle",
          "id": "handle",
          "startFrame": 20,
          "endFrame": 120,
          "fixed": true,
          "with": {
            "handle": "{{handle}}"
          }
        }
      ],
      "transitionIn": {
        "type": "{{transition}}",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    }
  ],
  "components": {
    "title_hero": {
      "description": "Opening title: small kicker, big headline that rises word by word, a short line under it.",
      "params": {
        "kicker": {
          "type": "string",
          "default": "INTRODUCING"
        },
        "headline": {
          "type": "string",
          "default": "Make something people remember"
        },
        "subtitle": {
          "type": "string",
          "default": "One clear line about why it matters."
        },
        "variant": {
          "type": "string",
          "default": "left",
          "description": "Layout: left (stacked left), center (centred stack) or band (accent panel on the left)"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.55)}}",
          "y": "{{round(canvas.height * -0.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.14,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.55)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.45000000000000007)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.44999999999999996)}}",
          "y": "{{round(canvas.height * 1.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.084,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 1.1)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 1)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "if": "{{variant == 'band'}}",
          "id": "band",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{round(canvas.width * 0.36)}}",
          "height": "{{canvas.height}}",
          "fill": "{{accent}}",
          "opacity": 1
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{variant == 'band' ? round(canvas.width * 0.04) : variant == 'center' ? 0 : round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * (variant == 'band' ? 0.3 : variant == 'center' ? 1 : 0.84))}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03 * density)}}",
            "align": "{{variant == 'center' ? 'center' : 'start'}}",
            "justify": "center"
          },
          "children": [
            {
              "id": "kicker",
              "type": "text",
              "content": "{{kicker}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "color": "{{variant == 'band' ? bg : accent}}",
              "fontWeight": 700,
              "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.006)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 20,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ],
              "fontFamily": "{{fontBody}}",
              "textAlign": "{{variant == 'center' ? 'center' : 'left'}}"
            },
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{variant == 'band' ? bg : text}}",
              "fontWeight": "{{headWeight}}",
              "lineHeight": 1.05,
              "maxWidth": "{{round(canvas.width * (variant == 'band' ? 0.28 : 0.84))}}",
              "maxLines": 4,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "{{motion}}",
                "duration": 18
              },
              "startFrame": 8,
              "fontFamily": "{{fontDisplay}}",
              "textAlign": "{{variant == 'center' ? 'center' : 'left'}}"
            },
            {
              "id": "rule",
              "type": "rect",
              "width": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.008)}}",
              "radius": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
              "fill": "{{variant == 'band' ? bg : accent}}",
              "startFrame": 26,
              "animations": [
                {
                  "property": "width",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 1
                    },
                    {
                      "frame": 20,
                      "value": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
                      "easing": "land"
                    }
                  ]
                }
              ]
            },
            {
              "id": "subtitle",
              "type": "text",
              "content": "{{subtitle}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{variant == 'band' ? bg : muted}}",
              "maxWidth": "{{round(canvas.width * (variant == 'band' ? 0.28 : 0.7))}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.028)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ],
              "fontFamily": "{{fontBody}}",
              "textAlign": "{{variant == 'center' ? 'center' : 'left'}}"
            }
          ]
        },
        {
          "id": "sfx-in",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 3,
          "volume": 0.45
        }
      ]
    },
    "big_stat": {
      "description": "One huge number with a line of context.",
      "params": {
        "value": {
          "type": "string",
          "default": "87%"
        },
        "label": {
          "type": "string",
          "default": "of viewers keep watching until the end"
        },
        "variant": {
          "type": "string",
          "default": "center",
          "description": "Layout: center (one centred column), left (aligned left) or split (number left, label right)"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.1)}}",
          "y": "{{round(canvas.height * 0.5)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.12,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.1)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.9)}}",
          "y": "{{round(canvas.height * 0.5)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.072,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.4)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{variant == 'left' ? round(canvas.width * 0.08) : 0}}",
          "y": 0,
          "width": "{{round(canvas.width * (variant == 'left' ? 0.84 : 1))}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "{{variant == 'split' ? 'row' : 'column'}}",
            "gap": "{{round(min(canvas.width, canvas.height) * (variant == 'split' ? 0.06 : 0.03) * density)}}",
            "align": "{{variant == 'left' ? 'start' : 'center'}}",
            "justify": "center"
          },
          "children": [
            {
              "id": "value",
              "type": "text",
              "content": "{{value}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * (variant == 'split' ? 0.22 : 0.3))}}",
              "color": "{{accent}}",
              "fontWeight": 900,
              "textAlign": "{{variant == 'left' ? 'left' : 'center'}}",
              "maxWidth": "{{round(canvas.width * (variant == 'split' ? 0.5 : 0.9))}}",
              "lineHeight": 1,
              "animations": [
                {
                  "property": "scale",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0.8,
                      "easing": "pop"
                    },
                    {
                      "frame": 22,
                      "value": 1
                    }
                  ]
                },
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 10,
                      "value": 1
                    }
                  ]
                }
              ],
              "fontFamily": "{{fontDisplay}}"
            },
            {
              "id": "label",
              "type": "text",
              "content": "{{label}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
              "color": "{{text}}",
              "textAlign": "{{variant == 'left' ? 'left' : 'center'}}",
              "maxWidth": "{{round(canvas.width * (variant == 'split' ? 0.36 : 0.72))}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "startFrame": 14,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ],
              "fontFamily": "{{fontDisplay}}"
            }
          ]
        },
        {
          "id": "sfx-hit",
          "type": "audio",
          "src": "sfx:pop",
          "startFrame": 4,
          "volume": 0.5
        }
      ]
    },
    "feature_list": {
      "description": "A title and up to six bullet points that appear one after another.",
      "params": {
        "title": {
          "type": "string",
          "default": "What you get"
        },
        "items": {
          "type": "list",
          "items": {
            "text": {
              "type": "string",
              "default": ""
            }
          },
          "default": [
            {
              "text": "Frame-exact, repeatable renders"
            },
            {
              "text": "Text that fits and reflows"
            },
            {
              "text": "Sound, captions and music in one file"
            },
            {
              "text": "Edit it all as plain JSON"
            }
          ]
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.7)}}",
          "y": "{{round(canvas.height * 0.6)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.1,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.7)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.6)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.30000000000000004)}}",
          "y": "{{round(canvas.height * 0.4)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.06,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.4)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.30000000000000004)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "title",
              "type": "text",
              "content": "{{title}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 2,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "items",
              "type": "group",
              "width": "{{round(canvas.width * 0.84)}}",
              "layout": {
                "direction": "column",
                "gap": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
                "align": "start"
              },
              "children": [
                {
                  "repeat": "{{items}}",
                  "as": "it",
                  "each": [
                    {
                      "id": "item-{{index}}",
                      "type": "group",
                      "startFrame": "{{16 + index * 12}}",
                      "layout": {
                        "direction": "row",
                        "gap": "{{round(min(canvas.width, canvas.height) * 0.026)}}",
                        "align": "center"
                      },
                      "animations": [
                        {
                          "property": "opacity",
                          "keyframes": [
                            {
                              "frame": 0,
                              "value": 0
                            },
                            {
                              "frame": 12,
                              "value": 1
                            }
                          ]
                        }
                      ],
                      "children": [
                        {
                          "id": "dot-{{index}}",
                          "type": "circle",
                          "width": "{{round(min(canvas.width, canvas.height) * 0.026)}}",
                          "fill": "{{accent}}"
                        },
                        {
                          "id": "line-{{index}}",
                          "type": "text",
                          "content": "{{it.text}}",
                          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
                          "color": "{{text}}",
                          "maxWidth": "{{round(canvas.width * 0.78)}}",
                          "maxLines": 2,
                          "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "repeat": "{{items}}",
          "as": "x",
          "each": [
            {
              "id": "sfx-item-{{index}}",
              "type": "audio",
              "src": "sfx:tick",
              "startFrame": "{{16 + index * 12}}",
              "volume": 0.35
            }
          ]
        }
      ]
    },
    "cta_end": {
      "description": "Closing scene: a headline, a button and a web address.",
      "params": {
        "headline": {
          "type": "string",
          "default": "Ready to start?"
        },
        "button": {
          "type": "string",
          "default": "Get started"
        },
        "url": {
          "type": "string",
          "default": "example.com"
        },
        "variant": {
          "type": "string",
          "default": "center",
          "description": "Layout: center (centred stack), left (aligned left) or panel (full accent panel with inverted text)"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.4)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.4)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.6)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.096,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.6)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.5)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "if": "{{variant == 'panel'}}",
          "id": "panel",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{accent}}",
          "opacity": 1
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{variant == 'left' ? round(canvas.width * 0.08) : 0}}",
          "y": 0,
          "width": "{{round(canvas.width * (variant == 'left' ? 0.84 : 1))}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.05 * density)}}",
            "align": "{{variant == 'left' ? 'start' : 'center'}}",
            "justify": "center"
          },
          "children": [
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{variant == 'panel' ? bg : text}}",
              "fontWeight": "{{headWeight}}",
              "textAlign": "{{variant == 'left' ? 'left' : 'center'}}",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "lineHeight": 1.05,
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "{{motion}}",
                "duration": 18
              },
              "fontFamily": "{{fontDisplay}}"
            },
            {
              "id": "btn",
              "type": "group",
              "width": "{{round(canvas.width * 0.42)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
              "startFrame": 24,
              "animations": [
                {
                  "property": "scale",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0.85,
                      "easing": "pop"
                    },
                    {
                      "frame": 16,
                      "value": 1
                    }
                  ]
                },
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 8,
                      "value": 1
                    }
                  ]
                }
              ],
              "children": [
                {
                  "id": "pill",
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{round(canvas.width * 0.42)}}",
                  "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
                  "radius": "{{round(min(canvas.width, canvas.height) * 0.065)}}",
                  "fill": "{{variant == 'panel' ? bg : accent}}"
                },
                {
                  "id": "label",
                  "type": "text",
                  "content": "{{button}}",
                  "x": "{{round(canvas.width * 0.21)}}",
                  "y": "{{round(min(canvas.width, canvas.height) * 0.065 - min(canvas.width, canvas.height) * 0.03)}}",
                  "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
                  "fontWeight": 800,
                  "color": "{{variant == 'panel' ? accent : bg}}",
                  "textAlign": "center",
                  "maxWidth": "{{round(canvas.width * 0.38)}}",
                  "maxLines": 1,
                  "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
                  "fontFamily": "{{fontDisplay}}"
                }
              ]
            },
            {
              "id": "url",
              "type": "text",
              "content": "{{url}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{variant == 'panel' ? bg : muted}}",
              "textAlign": "{{variant == 'left' ? 'left' : 'center'}}",
              "maxWidth": "{{round(canvas.width * 0.8)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 16,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ],
              "fontFamily": "{{fontBody}}"
            }
          ]
        },
        {
          "id": "sfx-btn",
          "type": "audio",
          "src": "sfx:ding",
          "startFrame": 24,
          "volume": 0.45
        }
      ]
    },
    "handle": {
      "description": "A social handle or website in the bottom right corner.",
      "params": {
        "handle": {
          "type": "string",
          "default": "@yourbrand"
        }
      },
      "layers": [
        {
          "id": "handle",
          "type": "text",
          "content": "{{handle}}",
          "x": "{{round(canvas.width * 0.94)}}",
          "y": "{{round(canvas.height * 0.93)}}",
          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
          "color": "{{muted}}",
          "textAlign": "right",
          "fontWeight": 600,
          "maxWidth": "{{round(canvas.width * 0.5)}}",
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 14,
                  "value": 1
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 48
  }
}
