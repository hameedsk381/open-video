{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "broll-loop",
  "name": "B-roll Loop Engineering",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": 150,
  "export": {
    "format": "mp4",
    "loudness": -14
  },
  "background": "#0b0d14",
  "grain": 0.08,
  "variables": {
    "kicker": {
      "type": "string",
      "default": "LOOP ENGINEERING",
      "description": "Category or topic header"
    },
    "headline": {
      "type": "string",
      "default": "Continuous momentum for speech",
      "description": "Main narration hook or beat statement"
    },
    "accent": {
      "type": "color",
      "default": "#38bdf8",
      "description": "Aura and glow color"
    }
  },
  "scenes": [
    {
      "id": "loop-scene",
      "name": "Loop Scene",
      "startFrame": 0,
      "durationFrames": 150,
      "camera": {
        "zoom": 1.0,
        "keyframes": [
          { "frame": 0, "zoom": 1.0, "easing": "easeInOut" },
          { "frame": 75, "zoom": 1.04, "easing": "easeInOut" },
          { "frame": 150, "zoom": 1.0 }
        ]
      },
      "layers": [
        {
          "id": "aura-glow",
          "type": "circle",
          "x": 540,
          "y": 860,
          "width": 860,
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 110,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 0, "value": 1.0, "easing": "easeInOut" },
                { "frame": 75, "value": 1.15, "easing": "easeInOut" },
                { "frame": 150, "value": 1.0 }
              ]
            }
          ]
        },
        {
          "id": "hero-card",
          "type": "rect",
          "x": 540,
          "y": 860,
          "width": 740,
          "height": 740,
          "fill": "#131722",
          "radius": 24,
          "stroke": "rgba(255,255,255,0.12)",
          "strokeWidth": 2,
          "shadow": {
            "color": "rgba(0,0,0,0.35)",
            "blur": 36,
            "offsetX": 0,
            "offsetY": 18
          },
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 0, "value": 860, "easing": "easeInOut" },
                { "frame": 75, "value": 842, "easing": "easeInOut" },
                { "frame": 150, "value": 860 }
              ]
            },
            {
              "property": "rotation",
              "keyframes": [
                { "frame": 0, "value": -1.5, "easing": "easeInOut" },
                { "frame": 75, "value": 1.5, "easing": "easeInOut" },
                { "frame": 150, "value": -1.5 }
              ]
            }
          ]
        },
        {
          "id": "badge-circle",
          "type": "circle",
          "x": 540,
          "y": 860,
          "width": 260,
          "fill": "{{accent}}",
          "opacity": 0.85,
          "shadow": {
            "color": "rgba(56,189,248,0.4)",
            "blur": 24,
            "offsetX": 0,
            "offsetY": 0
          },
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 0, "value": 860, "easing": "easeInOut" },
                { "frame": 75, "value": 842, "easing": "easeInOut" },
                { "frame": 150, "value": 860 }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                { "frame": 0, "value": 1.0, "easing": "easeInOut" },
                { "frame": 75, "value": 1.08, "easing": "easeInOut" },
                { "frame": 150, "value": 1.0 }
              ]
            }
          ]
        },
        {
          "id": "badge-icon",
          "type": "text",
          "content": "⚡",
          "fontSize": 110,
          "color": "#0b0d14",
          "x": 540,
          "y": 850,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 0, "value": 850, "easing": "easeInOut" },
                { "frame": 75, "value": 832, "easing": "easeInOut" },
                { "frame": 150, "value": 850 }
              ]
            }
          ]
        },
        {
          "id": "kicker",
          "type": "text",
          "content": "{{kicker}}",
          "fontFamily": "Inter",
          "fontWeight": 800,
          "fontSize": 36,
          "letterSpacing": 2,
          "color": "{{accent}}",
          "x": 540,
          "y": 380,
          "textAlign": "center"
        },
        {
          "id": "headline",
          "type": "text",
          "content": "{{headline}}",
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": 52,
          "lineHeight": 1.3,
          "color": "#f1f5f9",
          "maxWidth": 820,
          "textAlign": "center",
          "x": 540,
          "y": 1420
        },
        {
          "id": "ambient-drone",
          "type": "audio",
          "src": "sfx:ambient-pad",
          "startFrame": 0,
          "volume": 0.4
        }
      ]
    }
  ]
}

