{
  "version": "1.0",
  "id": "kinetic-type",
  "name": "Kinetic type",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#f2efe8",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#e6e2d8",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#0e0e0f",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#6d6a62",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#ff3d2e",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#ffb4a8",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "paper",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#000000",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.06,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "pop",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "push",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "word1": {
      "type": "string",
      "default": "MOVE",
      "description": "Word 1"
    },
    "word2": {
      "type": "string",
      "default": "FASTER",
      "description": "Word 2"
    },
    "word3": {
      "type": "string",
      "default": "THINK",
      "description": "Word 3"
    },
    "word4": {
      "type": "string",
      "default": "BIGGER",
      "description": "Word 4"
    },
    "message": {
      "type": "string",
      "default": "Say it with motion.",
      "description": "The closing line"
    },
    "url": {
      "type": "string",
      "default": "motionrender.dev",
      "description": "Small address under the closing line"
    }
  },
