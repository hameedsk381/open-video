{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "logo-reveal",
  "name": "Logo Reveal & Brand Bumper",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": 120,
  "export": {
    "format": "mp4",
    "loudness": -14
  },
  "background": "#090a0f",
  "grain": 0.08,
  "variables": {
    "brand": {
      "type": "string",
      "default": "MOTIONRENDER",
      "description": "Brand name"
    },
    "tagline": {
      "type": "string",
      "default": "ENGINEERED FOR AGENTS",
      "description": "Brand slogan or subtitle"
    },
    "accent": {
      "type": "color",
      "default": "#38bdf8",
      "description": "Primary glow and ring color"
    }
  },
  "scenes": [
    {
      "id": "reveal",
      "name": "Reveal",
      "startFrame": 0,
      "durationFrames": 120,
      "camera": {
        "zoom": 1.0,
        "keyframes": [
          { "frame": 0, "zoom": 1.0, "easing": "easeInOut" },
          { "frame": 120, "zoom": 1.04, "easing": "drift" }
        ]
      },
      "layers": [
        {
          "id": "ambient-halo",
          "type": "circle",
          "x": 960,
          "y": 480,
          "width": 800,
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 100,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 0, "value": 0.2, "easing": "easeOutCubic" },
                { "frame": 30, "value": 1.1 },
                { "frame": 120, "value": 1.0 }
              ]
            }
          ]
        },
        {
          "id": "orbital-ring",
          "type": "circle",
          "x": 960,
          "y": 480,
          "width": 380,
          "fill": "transparent",
          "stroke": "{{accent}}",
          "strokeWidth": 3,
          "shadow": {
            "color": "{{accent}}",
            "blur": 16,
            "offsetX": 0,
            "offsetY": 0
          },
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 6, "value": 0.1, "easing": "easeOutBack" },
                { "frame": 26, "value": 1.0 }
              ]
            },
            {
              "property": "rotation",
              "keyframes": [
                { "frame": 6, "value": -90, "easing": "easeOutCubic" },
                { "frame": 120, "value": 90 }
              ]
            }
          ]
        },
        {
          "id": "logo-symbol",
          "type": "text",
          "content": "✦",
          "fontSize": 180,
          "color": "{{accent}}",
          "x": 960,
          "y": 465,
          "shadow": {
            "color": "{{accent}}",
            "blur": 24,
            "offsetX": 0,
            "offsetY": 0
          },
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 10, "value": 0.1, "easing": "easeOutBack" },
                { "frame": 26, "value": 1.0 }
              ]
            }
          ]
        },
        {
          "id": "brand-title",
          "type": "text",
          "content": "{{brand}}",
          "fontFamily": "Inter",
          "fontWeight": 900,
          "fontSize": 64,
          "letterSpacing": 4,
          "color": "#f8fafc",
          "textAlign": "center",
          "x": 960,
          "y": 750,
          "startFrame": 20,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 20, "value": 780, "easing": "easeOutCubic" },
                { "frame": 34, "value": 750 }
              ]
            },
            {
              "property": "opacity",
              "keyframes": [
                { "frame": 20, "value": 0 },
                { "frame": 32, "value": 1 }
              ]
            }
          ]
        },
        {
          "id": "tagline-text",
          "type": "text",
          "content": "{{tagline}}",
          "fontFamily": "Inter",
          "fontWeight": 600,
          "fontSize": 32,
          "letterSpacing": 2,
          "color": "#94a3b8",
          "textAlign": "center",
          "x": 960,
          "y": 830,
          "startFrame": 28,
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                { "frame": 28, "value": 0 },
                { "frame": 40, "value": 1 }
              ]
            }
          ]
        },
        {
          "id": "sfx-whoosh",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 4,
          "volume": 0.65
        },
        {
          "id": "sfx-reveal-sparkle",
          "type": "audio",
          "src": "sfx:shimmer",
          "startFrame": 16,
          "volume": 0.75
        },
        {
          "id": "sfx-settle-impact",
          "type": "audio",
          "src": "sfx:impact",
          "startFrame": 24,
          "volume": 0.85
        }
      ]
    }
  ]
}

