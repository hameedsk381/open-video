{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "story-tall",
  "name": "Story (9:16)",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": "auto",
  "motionBlur": {
    "samples": 4,
    "shutter": 180
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0a0710",
      "description": "Theme: bg"
    },
    "surface": {
      "type": "color",
      "default": "#1b1030",
      "description": "Theme: surface"
    },
    "text": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: text"
    },
    "muted": {
      "type": "color",
      "default": "#b3a6d6",
      "description": "Theme: muted"
    },
    "accent": {
      "type": "color",
      "default": "#ff3cac",
      "description": "Theme: accent"
    },
    "accent2": {
      "type": "color",
      "default": "#c6ff3c",
      "description": "Theme: accent2"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: radius"
    },
    "headWeight": {
      "type": "number",
      "default": 900,
      "description": "Theme: headWeight"
    },
    "kicker": {
      "type": "string",
      "default": "JUST DROPPED",
      "description": "Small label above the hook"
    },
    "title": {
      "type": "string",
      "default": "Your next favourite thing",
      "description": "The hook (about 5 words)"
    },
    "subtitle": {
      "type": "string",
      "default": "Made for the way you actually work.",
      "description": "One supporting sentence"
    },
    "stat": {
      "type": "string",
      "default": "3x",
      "description": "The number to show"
    },
    "statLabel": {
      "type": "string",
      "default": "faster than doing it by hand",
      "description": "What it means"
    },
    "quote": {
      "type": "string",
      "default": "I stopped dreading Mondays.",
      "description": "A short customer quote"
    },
    "author": {
      "type": "string",
      "default": "Priya S.",
      "description": "Who said it"
    },
    "role": {
      "type": "string",
      "default": "Early customer",
      "description": "Their role"
    },
    "ctaHeadline": {
      "type": "string",
      "default": "Try it today",
      "description": "Closing line"
    },
    "ctaButton": {
      "type": "string",
      "default": "Start free",
      "description": "Button text"
    },
    "url": {
      "type": "string",
      "default": "example.com",
      "description": "Web address"
    },
    "badge": {
      "type": "string",
      "default": "NEW",
      "description": "Corner label on the opening scene"
    }
  },
  "scenes": [
    {
      "id": "title-hero",
      "name": "Title hero",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.08,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "title_hero",
          "id": "title-hero-block",
          "with": {
            "kicker": "{{kicker}}",
            "headline": "{{title}}",
            "subtitle": "{{subtitle}}"
          }
        },
        {
          "use": "badge",
          "id": "badge",
          "startFrame": 0,
          "endFrame": 90,
          "fixed": true,
          "with": {
            "label": "{{badge}}"
          }
        }
      ]
    },
    {
      "id": "big-stat",
      "name": "Big stat",
      "durationFrames": 90,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1.1
              },
              {
                "frame": 90,
                "value": 1,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "big_stat",
          "id": "big-stat-block",
          "with": {
            "value": "{{stat}}",
            "label": "{{statLabel}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "quote",
      "name": "Quote",
      "durationFrames": 150,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 150,
                "value": 1.05,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "quote",
          "id": "quote-block",
          "with": {
            "quote": "{{quote}}",
            "author": "{{author}}",
            "role": "{{role}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "cta-end",
      "name": "Call to action",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.06,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "cta_end",
          "id": "cta-end-block",
          "with": {
            "headline": "{{ctaHeadline}}",
            "button": "{{ctaButton}}",
            "url": "{{url}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    }
  ],
  "components": {
    "title_hero": {
      "description": "Opening title: small kicker, big headline that rises word by word, a short line under it.",
      "params": {
        "kicker": {
          "type": "string",
          "default": "INTRODUCING"
        },
        "headline": {
          "type": "string",
          "default": "Make something people remember"
        },
        "subtitle": {
          "type": "string",
          "default": "One clear line about why it matters."
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.55)}}",
          "y": "{{round(canvas.height * -0.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.14,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.55)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.45000000000000007)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.44999999999999996)}}",
          "y": "{{round(canvas.height * 1.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.084,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 1.1)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 1)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "kicker",
              "type": "text",
              "content": "{{kicker}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "color": "{{accent}}",
              "fontWeight": 700,
              "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.006)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 20,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "lineHeight": 1.05,
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 4,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "rise",
                "duration": 18
              },
              "startFrame": 8
            },
            {
              "id": "rule",
              "type": "rect",
              "width": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.008)}}",
              "radius": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
              "fill": "{{accent}}",
              "startFrame": 26,
              "animations": [
                {
                  "property": "width",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 1
                    },
                    {
                      "frame": 20,
                      "value": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
                      "easing": "land"
                    }
                  ]
                }
              ]
            },
            {
              "id": "subtitle",
              "type": "text",
              "content": "{{subtitle}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{muted}}",
              "maxWidth": "{{round(canvas.width * 0.7)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.028)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-in",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 3,
          "volume": 0.45
        }
      ]
    },
    "big_stat": {
      "description": "One huge number with a line of context.",
      "params": {
        "value": {
          "type": "string",
          "default": "87%"
        },
        "label": {
          "type": "string",
          "default": "of viewers keep watching until the end"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.1)}}",
          "y": "{{round(canvas.height * 0.5)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.12,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.1)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.9)}}",
          "y": "{{round(canvas.height * 0.5)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.072,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.4)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
            "align": "center",
            "justify": "center"
          },
          "children": [
            {
              "id": "value",
              "type": "text",
              "content": "{{value}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.3)}}",
              "color": "{{accent}}",
              "fontWeight": 900,
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.9)}}",
              "lineHeight": 1,
              "animations": [
                {
                  "property": "scale",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0.8,
                      "easing": "pop"
                    },
                    {
                      "frame": 22,
                      "value": 1
                    }
                  ]
                },
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 10,
                      "value": 1
                    }
                  ]
                }
              ]
            },
            {
              "id": "label",
              "type": "text",
              "content": "{{label}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
              "color": "{{text}}",
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.72)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "startFrame": 14,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-hit",
          "type": "audio",
          "src": "sfx:pop",
          "startFrame": 4,
          "volume": 0.5
        }
      ]
    },
    "quote": {
      "description": "A pull quote with author and role.",
      "params": {
        "quote": {
          "type": "string",
          "default": "The best videos are built one honest frame at a time."
        },
        "author": {
          "type": "string",
          "default": "Mira Chen"
        },
        "role": {
          "type": "string",
          "default": "Creative director"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.6)}}",
          "y": "{{round(canvas.height * -0.2)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.1,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.6)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.5)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.4)}}",
          "y": "{{round(canvas.height * 1.2)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.06,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 1.2)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 1.1)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.025)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "mark",
              "type": "text",
              "content": "“",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.26)}}",
              "color": "{{accent}}",
              "fontWeight": 900,
              "lineHeight": 0.7,
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 20,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "quote",
              "type": "text",
              "content": "{{quote}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "color": "{{text}}",
              "fontWeight": 700,
              "lineHeight": 1.15,
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 6,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "startFrame": 8,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 28,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "rule",
              "type": "rect",
              "width": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.008)}}",
              "radius": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
              "fill": "{{accent}}",
              "startFrame": 30,
              "animations": [
                {
                  "property": "width",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 1
                    },
                    {
                      "frame": 20,
                      "value": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
                      "easing": "land"
                    }
                  ]
                }
              ]
            },
            {
              "id": "author",
              "type": "text",
              "content": "{{author}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{text}}",
              "fontWeight": 700,
              "startFrame": 38,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 18,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "role",
              "type": "text",
              "content": "{{role}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "color": "{{muted}}",
              "startFrame": 42,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 18,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-in",
          "type": "audio",
          "src": "sfx:tick",
          "startFrame": 6,
          "volume": 0.35
        }
      ]
    },
    "cta_end": {
      "description": "Closing scene: a headline, a button and a web address.",
      "params": {
        "headline": {
          "type": "string",
          "default": "Ready to start?"
        },
        "button": {
          "type": "string",
          "default": "Get started"
        },
        "url": {
          "type": "string",
          "default": "example.com"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.4)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.4)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.6)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.096,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.6)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.5)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
            "align": "center",
            "justify": "center"
          },
          "children": [
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "lineHeight": 1.05,
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "rise",
                "duration": 18
              }
            },
            {
              "id": "btn",
              "type": "group",
              "width": "{{round(canvas.width * 0.42)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
              "startFrame": 24,
              "animations": [
                {
                  "property": "scale",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0.85,
                      "easing": "pop"
                    },
                    {
                      "frame": 16,
                      "value": 1
                    }
                  ]
                },
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 8,
                      "value": 1
                    }
                  ]
                }
              ],
              "children": [
                {
                  "id": "pill",
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{round(canvas.width * 0.42)}}",
                  "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
                  "radius": "{{round(min(canvas.width, canvas.height) * 0.065)}}",
                  "fill": "{{accent}}"
                },
                {
                  "id": "label",
                  "type": "text",
                  "content": "{{button}}",
                  "x": "{{round(canvas.width * 0.21)}}",
                  "y": "{{round(min(canvas.width, canvas.height) * 0.065 - min(canvas.width, canvas.height) * 0.03)}}",
                  "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
                  "fontWeight": 800,
                  "color": "{{bg}}",
                  "textAlign": "center",
                  "maxWidth": "{{round(canvas.width * 0.38)}}",
                  "maxLines": 1,
                  "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}"
                }
              ]
            },
            {
              "id": "url",
              "type": "text",
              "content": "{{url}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{muted}}",
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.8)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 16,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-btn",
          "type": "audio",
          "src": "sfx:ding",
          "startFrame": 24,
          "volume": 0.45
        }
      ]
    },
    "badge": {
      "description": "A small highlighted label in the top left corner, such as NEW or LIVE.",
      "params": {
        "label": {
          "type": "string",
          "default": "NEW"
        }
      },
      "layers": [
        {
          "id": "tag",
          "type": "text",
          "spans": [
            {
              "text": "  {{label}}  ",
              "background": "{{accent}}",
              "color": "{{bg}}",
              "fontWeight": 800
            }
          ],
          "x": "{{round(canvas.width * 0.06)}}",
          "y": "{{round(canvas.height * 0.09)}}",
          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
          "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.003)}}",
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 10,
                  "value": 1
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.8,
                  "easing": "pop"
                },
                {
                  "frame": 14,
                  "value": 1
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-in",
          "type": "audio",
          "src": "sfx:pop",
          "startFrame": 0,
          "volume": 0.3
        }
      ]
    }
  }
}
