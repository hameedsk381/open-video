{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "collage-broll",
  "name": "Editorial Collage B-roll",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": 150,
  "background": "#e8e0d5",
  "grain": 0.12,
  "variables": {
    "label": {
      "type": "string",
      "default": "CRITICAL INSIGHT",
      "description": "Punchy tag on paper tape"
    },
    "headline": {
      "type": "string",
      "default": "Built frame by frame",
      "description": "Main editorial takeaway"
    },
    "accent": {
      "type": "color",
      "default": "#facc15",
      "description": "Highlight tape colour"
    }
  },
  "scenes": [
    {
      "id": "collage",
      "name": "Collage",
      "startFrame": 0,
      "durationFrames": 150,
      "camera": {
        "zoom": 1.0,
        "keyframes": [
          { "frame": 0, "zoom": 1.0 },
          { "frame": 150, "zoom": 1.05, "easing": "drift" }
        ]
      },
      "transitionIn": { "type": "fade", "durationFrames": 12 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "cardstock",
          "type": "rect",
          "x": 540,
          "y": 920,
          "width": 820,
          "height": 1100,
          "rotation": -2.5,
          "fill": "#fcfbf7",
          "radius": 4,
          "shadow": {
            "color": "rgba(0,0,0,0.18)",
            "blur": 28,
            "offsetX": 8,
            "offsetY": 14
          },
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 0, "value": 2100, "easing": "easeOutBack" },
                { "frame": 18, "value": 920 }
              ]
            }
          ]
        },
        {
          "id": "photo-plate",
          "type": "rect",
          "x": 540,
          "y": 860,
          "width": 640,
          "height": 640,
          "rotation": 2.5,
          "fill": "#18181b",
          "radius": 6,
          "stroke": "#ffffff",
          "strokeWidth": 12,
          "shadow": {
            "color": "rgba(0,0,0,0.24)",
            "blur": 20,
            "offsetX": 6,
            "offsetY": 10
          },
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 10, "value": 0.4, "easing": "easeOutBack" },
                { "frame": 24, "value": 1.0 }
              ]
            }
          ]
        },
        {
          "id": "photo-cutout-symbol",
          "type": "text",
          "content": "✂",
          "fontSize": 180,
          "color": "#facc15",
          "x": 540,
          "y": 830,
          "rotation": 15,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                { "frame": 12, "value": 0 },
                { "frame": 26, "value": 1, "easing": "easeOutBack" }
              ]
            }
          ]
        },
        {
          "id": "tape-top",
          "type": "rect",
          "x": 400,
          "y": 420,
          "width": 240,
          "height": 65,
          "rotation": -15,
          "fill": "rgba(240, 230, 210, 0.85)",
          "startFrame": 20,
          "shadow": {
            "color": "rgba(0,0,0,0.08)",
            "blur": 4,
            "offsetX": 1,
            "offsetY": 2
          }
        },
        {
          "id": "label-badge",
          "type": "text",
          "content": "{{label}}",
          "fontFamily": "Inter",
          "fontWeight": 900,
          "fontSize": 40,
          "color": "#111111",
          "background": "{{accent}}",
          "padding": 16,
          "rotation": -3.5,
          "x": 540,
          "y": 1260,
          "startFrame": 28,
          "shadow": {
            "color": "rgba(0,0,0,0.2)",
            "blur": 12,
            "offsetX": 4,
            "offsetY": 6
          },
          "animations": [
            {
              "property": "y",
              "keyframes": [
                { "frame": 28, "value": 1380, "easing": "easeOutCubic" },
                { "frame": 38, "value": 1260 }
              ]
            }
          ]
        },
        {
          "id": "headline-text",
          "type": "text",
          "content": "{{headline}}",
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": 48,
          "color": "#18181b",
          "maxWidth": 720,
          "textAlign": "center",
          "x": 540,
          "y": 1380,
          "startFrame": 36,
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                { "frame": 36, "value": 0 },
                { "frame": 46, "value": 1 }
              ]
            }
          ]
        },
        {
          "id": "sfx-paper-drop",
          "type": "audio",
          "src": "sfx:thump",
          "startFrame": 14,
          "volume": 0.85
        },
        {
          "id": "sfx-subject-slide",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 18,
          "volume": 0.6
        },
        {
          "id": "sfx-tag-snap",
          "type": "audio",
          "src": "sfx:pop",
          "startFrame": 28,
          "volume": 0.65
        }
      ]
    }
  ]
}

