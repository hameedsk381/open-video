{
  "version": "1.0",
  "id": "stats-showcase",
  "name": "Stats showcase",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0b0f14",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#131a22",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#f5f2ea",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#98a3b0",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#ffc23d",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#ffe3a0",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "grid",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.04,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "2026 IN NUMBERS",
      "description": "Small label"
    },
    "title": {
      "type": "string",
      "default": "A year of\nshipping.",
      "description": "Opening headline"
    },
    "s1": {
      "type": "string",
      "default": "12M",
      "description": "Stat 1 value"
    },
    "s1d": {
      "type": "string",
      "default": "videos rendered",
      "description": "Stat 1 caption"
    },
    "s2": {
      "type": "string",
      "default": "99.9%",
      "description": "Stat 2 value"
    },
    "s2d": {
      "type": "string",
      "default": "frames identical on re-render",
      "description": "Stat 2 caption"
    },
    "s3": {
      "type": "string",
      "default": "4x",
      "description": "Stat 3 value"
    },
    "s3d": {
      "type": "string",
      "default": "faster than last year",
      "description": "Stat 3 caption"
    },
    "closing": {
      "type": "string",
      "default": "And we are just getting started.",
      "description": "Closing line"
    }
  },
