          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 10, "value": 1, "easing": "glide" }] },
            { "property": "scale", "keyframes": [{ "frame": 0, "value": 0.8 }, { "frame": 12, "value": 1.05, "easing": "pop" }, { "frame": 18, "value": 1.0, "easing": "land" }] }
