{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "creator-reel",
  "name": "Creator Reel",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": 360,
  "background": "#fafafa",
  "variables": {
    "handle": {
      "type": "string",
      "default": "@creator.ai",
      "description": "Creator social handle"
    },
    "creatorName": {
      "type": "string",
      "default": "Alex Rivera",
      "description": "Creator display name"
    },
    "creatorTitle": {
      "type": "string",
      "default": "AI & Motion Strategist",
      "description": "Creator subtitle"
    },
    "hookQuestion": {
      "type": "string",
      "default": "Still editing reels by hand?",
      "description": "Opening question hook"
    },
    "followers": {
      "type": "string",
      "default": "16.4K",
      "description": "Follower count metric"
    },
    "ctaWord": {
      "type": "string",
      "default": "REEL",
      "description": "Keyword to trigger DM automation"
    },
    "accent": {
      "type": "color",
      "default": "#3b82f6",
      "description": "Primary accent brand color"
    }
  },
  "scenes": [
    {
      "id": "scene-1-hook",
      "name": "Hook & Timeline",
      "startFrame": 0,
      "durationFrames": 90,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              { "frame": 0, "value": 1.0 },
              { "frame": 90, "value": 1.05, "easing": "drift" }
            ]
          }
        ]
      },
      "transitionOut": { "type": "fade", "durationFrames": 8 },
      "layers": [
        {
          "id": "s1-grid",
          "type": "image",
