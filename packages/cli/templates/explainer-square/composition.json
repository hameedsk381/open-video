{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "explainer-square",
  "name": "Explainer (1:1)",
  "width": 1080,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "motionBlur": {
    "samples": 4,
    "shutter": 180
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#f6f1e8",
      "description": "Theme: bg"
    },
    "surface": {
      "type": "color",
      "default": "#e9e1d2",
      "description": "Theme: surface"
    },
    "text": {
      "type": "color",
      "default": "#1d1a16",
      "description": "Theme: text"
    },
    "muted": {
      "type": "color",
      "default": "#6e665a",
      "description": "Theme: muted"
    },
    "accent": {
      "type": "color",
      "default": "#d9482b",
      "description": "Theme: accent"
    },
    "accent2": {
      "type": "color",
      "default": "#1f6f5c",
      "description": "Theme: accent2"
    },
    "radius": {
      "type": "number",
      "default": 8,
      "description": "Theme: radius"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: headWeight"
    },
    "kicker": {
      "type": "string",
      "default": "HOW IT WORKS",
      "description": "Small label above the title"
    },
    "title": {
      "type": "string",
      "default": "From idea to finished in three steps",
      "description": "The title (about 6 words)"
    },
    "subtitle": {
      "type": "string",
      "default": "No jargon, no waiting.",
      "description": "One supporting sentence"
    },
    "stepsTitle": {
      "type": "string",
      "default": "The three steps",
      "description": "Heading of the steps"
    },
    "steps": {
      "type": "list",
      "items": {
        "title": {
          "type": "string",
          "default": ""
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "default": [
        {
          "title": "Tell us what you need",
          "detail": "A few words is enough."
        },
        {
          "title": "Check the draft",
          "detail": "Change anything you like."
        },
        {
          "title": "Publish",
          "detail": "Share it everywhere at once."
        }
      ],
      "description": "Up to four steps with a short title and detail"
    },
    "resultsTitle": {
      "type": "string",
      "default": "What people see",
      "description": "Heading of the numbers"
    },
    "results": {
      "type": "list",
      "items": {
        "value": {
          "type": "string",
          "default": ""
        },
        "label": {
          "type": "string",
          "default": ""
        }
      },
      "default": [
        {
          "value": "3x",
          "label": "faster"
        },
        {
          "value": "40%",
          "label": "lower cost"
        },
        {
          "value": "100%",
          "label": "repeatable"
        }
      ],
      "description": "Exactly three numbers with labels"
    },
    "ctaHeadline": {
      "type": "string",
      "default": "Start today",
      "description": "Closing line"
    },
    "ctaButton": {
      "type": "string",
      "default": "Get started",
      "description": "Button text"
    },
    "url": {
      "type": "string",
      "default": "example.com",
      "description": "Web address"
    }
  },
  "scenes": [
    {
      "id": "title-hero",
      "name": "Title hero",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.08,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "title_hero",
          "id": "title-hero-block",
          "with": {
            "kicker": "{{kicker}}",
            "headline": "{{title}}",
            "subtitle": "{{subtitle}}"
          }
        }
      ]
    },
    {
      "id": "steps",
      "name": "Numbered steps",
      "durationFrames": 180,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 180,
                "value": 1.04,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "steps",
          "id": "steps-block",
          "with": {
            "title": "{{stepsTitle}}",
            "steps": "{{steps}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "stat-grid",
      "name": "Stat grid",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.05,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "stat_grid",
          "id": "stat-grid-block",
          "with": {
            "title": "{{resultsTitle}}",
            "stats": "{{results}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    },
    {
      "id": "cta-end",
      "name": "Call to action",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.06,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "use": "cta_end",
          "id": "cta-end-block",
          "with": {
            "headline": "{{ctaHeadline}}",
            "button": "{{ctaButton}}",
            "url": "{{url}}"
          }
        }
      ],
      "transitionIn": {
        "type": "push",
        "durationFrames": 16,
        "direction": "left",
        "easing": "glide"
      }
    }
  ],
  "components": {
    "title_hero": {
      "description": "Opening title: small kicker, big headline that rises word by word, a short line under it.",
      "params": {
        "kicker": {
          "type": "string",
          "default": "INTRODUCING"
        },
        "headline": {
          "type": "string",
          "default": "Make something people remember"
        },
        "subtitle": {
          "type": "string",
          "default": "One clear line about why it matters."
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.55)}}",
          "y": "{{round(canvas.height * -0.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.14,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.55)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.45000000000000007)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.44999999999999996)}}",
          "y": "{{round(canvas.height * 1.1)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.084,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 1.1)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 1)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "kicker",
              "type": "text",
              "content": "{{kicker}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
              "color": "{{accent}}",
              "fontWeight": 700,
              "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.006)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 20,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "lineHeight": 1.05,
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 4,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "rise",
                "duration": 18
              },
              "startFrame": 8
            },
            {
              "id": "rule",
              "type": "rect",
              "width": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.008)}}",
              "radius": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
              "fill": "{{accent}}",
              "startFrame": 26,
              "animations": [
                {
                  "property": "width",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 1
                    },
                    {
                      "frame": 20,
                      "value": "{{round(min(canvas.width, canvas.height) * 0.12)}}",
                      "easing": "land"
                    }
                  ]
                }
              ]
            },
            {
              "id": "subtitle",
              "type": "text",
              "content": "{{subtitle}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{muted}}",
              "maxWidth": "{{round(canvas.width * 0.7)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.028)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-in",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 3,
          "volume": 0.45
        }
      ]
    },
    "steps": {
      "description": "Up to four numbered steps, each with a short title and a line of detail.",
      "params": {
        "title": {
          "type": "string",
          "default": "How it works"
        },
        "steps": {
          "type": "list",
          "items": {
            "title": {
              "type": "string",
              "default": ""
            },
            "detail": {
              "type": "string",
              "default": ""
            }
          },
          "default": [
            {
              "title": "Write the brief",
              "detail": "Say what the video is about."
            },
            {
              "title": "Check it",
              "detail": "Errors are reported with their location."
            },
            {
              "title": "Render it",
              "detail": "The same file gives the same video, every time."
            }
          ]
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "title",
              "type": "text",
              "content": "{{title}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 2,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "rows",
              "type": "group",
              "width": "{{round(canvas.width * 0.84)}}",
              "layout": {
                "direction": "column",
                "gap": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
                "align": "start"
              },
              "children": [
                {
                  "repeat": "{{steps}}",
                  "as": "s",
                  "each": [
                    {
                      "id": "step-{{index}}",
                      "type": "group",
                      "startFrame": "{{18 + index * 20}}",
                      "layout": {
                        "direction": "row",
                        "gap": "{{round(min(canvas.width, canvas.height) * 0.03)}}",
                        "align": "start"
                      },
                      "animations": [
                        {
                          "property": "opacity",
                          "keyframes": [
                            {
                              "frame": 0,
                              "value": 0
                            },
                            {
                              "frame": 12,
                              "value": 1
                            }
                          ]
                        },
                        {
                          "property": "y",
                          "keyframes": [
                            {
                              "frame": 0,
                              "value": 30,
                              "easing": "land"
                            },
                            {
                              "frame": 18,
                              "value": 0
                            }
                          ]
                        }
                      ],
                      "children": [
                        {
                          "id": "num-{{index}}",
                          "type": "group",
                          "width": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
                          "height": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
                          "children": [
                            {
                              "id": "disc",
                              "type": "circle",
                              "x": "{{round(min(canvas.width, canvas.height) * 0.0375)}}",
                              "y": "{{round(min(canvas.width, canvas.height) * 0.0375)}}",
                              "width": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
                              "fill": "{{accent}}"
                            },
                            {
                              "id": "n",
                              "type": "text",
                              "content": "{{string(index + 1)}}",
                              "x": "{{round(min(canvas.width, canvas.height) * 0.0375)}}",
                              "y": "{{round(min(canvas.width, canvas.height) * 0.0375 - min(canvas.width, canvas.height) * 0.0225)}}",
                              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
                              "fontWeight": 800,
                              "color": "{{bg}}",
                              "textAlign": "center"
                            }
                          ]
                        },
                        {
                          "id": "copy-{{index}}",
                          "type": "group",
                          "layout": {
                            "direction": "column",
                            "gap": "{{round(min(canvas.width, canvas.height) * 0.008)}}"
                          },
                          "children": [
                            {
                              "id": "st-{{index}}",
                              "type": "text",
                              "content": "{{s.title}}",
                              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
                              "color": "{{text}}",
                              "fontWeight": 700,
                              "maxWidth": "{{round(canvas.width * 0.7)}}",
                              "maxLines": 2,
                              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}"
                            },
                            {
                              "id": "sd-{{index}}",
                              "type": "text",
                              "content": "{{s.detail}}",
                              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
                              "color": "{{muted}}",
                              "maxWidth": "{{round(canvas.width * 0.7)}}",
                              "maxLines": 2,
                              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.026)}}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "repeat": "{{steps}}",
          "as": "x",
          "each": [
            {
              "id": "sfx-step-{{index}}",
              "type": "audio",
              "src": "sfx:tick",
              "startFrame": "{{18 + index * 20}}",
              "volume": 0.4
            }
          ]
        }
      ]
    },
    "stat_grid": {
      "description": "Three numbers side by side, each with a label.",
      "params": {
        "title": {
          "type": "string",
          "default": "The results"
        },
        "stats": {
          "type": "list",
          "items": {
            "value": {
              "type": "string",
              "default": ""
            },
            "label": {
              "type": "string",
              "default": ""
            }
          },
          "default": [
            {
              "value": "3x",
              "label": "faster to make"
            },
            {
              "value": "40%",
              "label": "lower cost"
            },
            {
              "value": "100%",
              "label": "repeatable"
            }
          ]
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.8)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.1,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.4)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.19999999999999996)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.06,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.19999999999999996)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.09999999999999998)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": "{{round(canvas.width * 0.08)}}",
          "y": 0,
          "width": "{{round(canvas.width * 0.84)}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.07)}}",
            "align": "start",
            "justify": "center"
          },
          "children": [
            {
              "id": "title",
              "type": "text",
              "content": "{{title}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 2,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.036)}}",
              "startFrame": 0,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 24,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "id": "cells",
              "type": "group",
              "width": "{{round(canvas.width * 0.84)}}",
              "layout": {
                "direction": "row",
                "gap": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
                "align": "start",
                "justify": "space-between"
              },
              "children": [
                {
                  "repeat": "{{stats}}",
                  "as": "st",
                  "each": [
                    {
                      "id": "cell-{{index}}",
                      "type": "group",
                      "startFrame": "{{14 + index * 12}}",
                      "layout": {
                        "direction": "column",
                        "gap": "{{round(min(canvas.width, canvas.height) * 0.012)}}"
                      },
                      "animations": [
                        {
                          "property": "opacity",
                          "keyframes": [
                            {
                              "frame": 0,
                              "value": 0
                            },
                            {
                              "frame": 12,
                              "value": 1
                            }
                          ]
                        },
                        {
                          "property": "y",
                          "keyframes": [
                            {
                              "frame": 0,
                              "value": 30,
                              "easing": "land"
                            },
                            {
                              "frame": 18,
                              "value": 0
                            }
                          ]
                        }
                      ],
                      "children": [
                        {
                          "id": "bar-{{index}}",
                          "type": "rect",
                          "width": "{{round(canvas.width * 0.84 / max(count, 1) - min(canvas.width, canvas.height) * 0.04)}}",
                          "height": "{{round(min(canvas.width, canvas.height) * 0.008)}}",
                          "fill": "{{accent}}"
                        },
                        {
                          "id": "v-{{index}}",
                          "type": "text",
                          "content": "{{st.value}}",
                          "fontSize": "{{round(min(min(canvas.width, canvas.height) * 0.08, (canvas.width * 0.84 / max(count, 1) - min(canvas.width, canvas.height) * 0.04) * 0.3))}}",
                          "color": "{{accent}}",
                          "fontWeight": 900,
                          "maxWidth": "{{round(canvas.width * 0.84 / max(count, 1) - min(canvas.width, canvas.height) * 0.04)}}",
                          "lineHeight": 1.05
                        },
                        {
                          "id": "l-{{index}}",
                          "type": "text",
                          "content": "{{st.label}}",
                          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}",
                          "color": "{{muted}}",
                          "maxWidth": "{{round(canvas.width * 0.84 / max(count, 1) - min(canvas.width, canvas.height) * 0.04)}}",
                          "maxLines": 3,
                          "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.026)}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "repeat": "{{stats}}",
          "as": "x",
          "each": [
            {
              "id": "sfx-cell-{{index}}",
              "type": "audio",
              "src": "sfx:pop",
              "startFrame": "{{14 + index * 12}}",
              "volume": 0.4
            }
          ]
        }
      ]
    },
    "cta_end": {
      "description": "Closing scene: a headline, a button and a web address.",
      "params": {
        "headline": {
          "type": "string",
          "default": "Ready to start?"
        },
        "button": {
          "type": "string",
          "default": "Get started"
        },
        "url": {
          "type": "string",
          "default": "example.com"
        }
      },
      "layers": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "id": "glow",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.4)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 120,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.9
                },
                {
                  "frame": 150,
                  "value": 1.1,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.width * 0.5)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.width * 0.4)}}",
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "glow2",
          "type": "circle",
          "x": "{{round(canvas.width * 0.5)}}",
          "y": "{{round(canvas.height * 0.6)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
          "fill": "{{accent2}}",
          "opacity": 0.096,
          "blur": 140,
          "animations": [
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{round(canvas.height * 0.6)}}"
                },
                {
                  "frame": 180,
                  "value": "{{round(canvas.height * 0.5)}}",
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1
                },
                {
                  "frame": 150,
                  "value": 0.9,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "stack",
          "type": "group",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "layout": {
            "direction": "column",
            "gap": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
            "align": "center",
            "justify": "center"
          },
          "children": [
            {
              "id": "headline",
              "type": "text",
              "content": "{{headline}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.1)}}",
              "color": "{{text}}",
              "fontWeight": "{{headWeight}}",
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.84)}}",
              "maxLines": 3,
              "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.06)}}",
              "lineHeight": 1.05,
              "split": {
                "by": "words",
                "stagger": 4,
                "preset": "rise",
                "duration": 18
              }
            },
            {
              "id": "btn",
              "type": "group",
              "width": "{{round(canvas.width * 0.42)}}",
              "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
              "startFrame": 24,
              "animations": [
                {
                  "property": "scale",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0.85,
                      "easing": "pop"
                    },
                    {
                      "frame": 16,
                      "value": 1
                    }
                  ]
                },
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 8,
                      "value": 1
                    }
                  ]
                }
              ],
              "children": [
                {
                  "id": "pill",
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{round(canvas.width * 0.42)}}",
                  "height": "{{round(min(canvas.width, canvas.height) * 0.13)}}",
                  "radius": "{{round(min(canvas.width, canvas.height) * 0.065)}}",
                  "fill": "{{accent}}"
                },
                {
                  "id": "label",
                  "type": "text",
                  "content": "{{button}}",
                  "x": "{{round(canvas.width * 0.21)}}",
                  "y": "{{round(min(canvas.width, canvas.height) * 0.065 - min(canvas.width, canvas.height) * 0.03)}}",
                  "fontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
                  "fontWeight": 800,
                  "color": "{{bg}}",
                  "textAlign": "center",
                  "maxWidth": "{{round(canvas.width * 0.38)}}",
                  "maxLines": 1,
                  "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.032)}}"
                }
              ]
            },
            {
              "id": "url",
              "type": "text",
              "content": "{{url}}",
              "fontSize": "{{round(min(canvas.width, canvas.height) * 0.04)}}",
              "color": "{{muted}}",
              "textAlign": "center",
              "maxWidth": "{{round(canvas.width * 0.8)}}",
              "startFrame": 34,
              "animations": [
                {
                  "property": "opacity",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 0
                    },
                    {
                      "frame": 14,
                      "value": 1,
                      "easing": "glide"
                    }
                  ]
                },
                {
                  "property": "y",
                  "keyframes": [
                    {
                      "frame": 0,
                      "value": 16,
                      "easing": "land"
                    },
                    {
                      "frame": 18,
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-btn",
          "type": "audio",
          "src": "sfx:ding",
          "startFrame": 24,
          "volume": 0.45
        }
      ]
    }
  }
}
