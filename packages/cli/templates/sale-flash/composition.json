{
  "version": "1.0",
  "id": "sale-flash",
  "name": "Sale flash",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#fff23d",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#0b0b0b",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#3a3a30",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#0b0b0b",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#ff3d2e",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 900,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "pop",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "push",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "FLASH SALE",
      "description": "Small label"
    },
    "offer": {
      "type": "string",
      "default": "40%\nOFF",
      "description": "The offer; a line break starts a new line"
    },
    "sub": {
      "type": "string",
      "default": "Everything in the shop, this weekend only.",
      "description": "One line under the offer"
    },
    "p1": {
      "type": "string",
      "default": "Free shipping",
      "description": "Perk 1"
    },
    "p2": {
      "type": "string",
      "default": "30-day returns",
      "description": "Perk 2"
    },
    "p3": {
      "type": "string",
      "default": "Gift wrap on us",
      "description": "Perk 3"
    },
    "ends": {
      "type": "string",
      "default": "ENDS SUNDAY MIDNIGHT",
      "description": "Deadline"
    },
    "codeLabel": {
      "type": "string",
      "default": "USE CODE",
      "description": "Label above the code"
    },
    "code": {
      "type": "string",
      "default": "FLASH40",
      "description": "Promo code"
    },
    "url": {
      "type": "string",
      "default": "shop.example.com",
      "description": "Address"
    }
  },
