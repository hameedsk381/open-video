{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "testimonial",
  "name": "Testimonial",
  "width": 1080,
  "height": 1080,
  "fps": 30,
  "durationFrames": 210,
  "background": {
    "type": "linear",
    "from": [0, 0],
    "to": [1080, 1080],
    "stops": [
      { "offset": 0, "color": "{{bg}}" },
      { "offset": 1, "color": "{{surface}}" }
    ]
  },
  "variables": {
    "bg": { "type": "color", "default": "#0b0f1a", "description": "Theme: bg" },
    "surface": { "type": "color", "default": "#141b2e", "description": "Theme: surface" },
    "text": { "type": "color", "default": "#f8fafc", "description": "Theme: text" },
    "muted": { "type": "color", "default": "#94a3b8", "description": "Theme: muted" },
    "accent": { "type": "color", "default": "#7c9cff", "description": "Theme: accent" },
    "accent2": { "type": "color", "default": "#fbbf24", "description": "Theme: accent2" },
    "headWeight": { "type": "number", "default": 800, "description": "Theme: headWeight" },
    "label": { "type": "string", "default": "VERIFIED REVIEW", "description": "Eyebrow above the quote" },
    "quote": { "type": "string", "default": "We shipped our launch film in an afternoon. The first cut was the final cut, and the numbers moved the same week." },
    "customer": { "type": "string", "default": "Mira Chen" },
    "company": { "type": "string", "default": "Northlight · Head of Brand" },
    "initials": { "type": "string", "default": "MC", "description": "Two or three letters in the avatar" },
    "score": { "type": "string", "default": "5.0" }
  },
  "scenes": [
    {
      "id": "testimonial",
      "name": "Testimonial",
      "startFrame": 0,
      "durationFrames": 210,
      "camera": {
        "animations": [
          { "property": "zoom", "keyframes": [{ "frame": 0, "value": 1 }, { "frame": 210, "value": 1.05, "easing": "drift" }] }
        ]
      },
      "transitionIn": { "type": "fade", "durationFrames": 10 },
      "transitionOut": { "type": "fade", "durationFrames": 10 },
      "layers": [
        {
          "id": "glow",
          "type": "circle",
          "x": 620,
          "y": -280,
          "width": 820,
          "fill": "{{accent}}",
          "opacity": 0.14,
          "blur": 80,
          "animations": [
            { "property": "x", "keyframes": [{ "frame": 0, "value": 700 }, { "frame": 210, "value": 540, "easing": "drift" }] }
          ]
        },
        {
          "id": "warmth",
          "type": "circle",
          "x": -280,
          "y": 760,
          "width": 620,
          "fill": "{{accent2}}",
          "opacity": 0.07,
          "blur": 90
        },
        {
          "id": "label",
          "type": "text",
          "content": "{{label}}",
          "x": 96,
          "y": 96,
          "fontSize": 24,
          "fontWeight": 700,
          "letterSpacing": 3,
          "maxWidth": 600,
          "maxLines": 1,
          "color": "{{muted}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 18, "value": 1 }] }
          ]
        },
        {
          "id": "mark",
          "type": "text",
          "content": "“",
          "x": 88,
          "y": 118,
          "fontSize": 200,
          "fontWeight": 800,
          "lineHeight": 1,
          "color": "{{accent}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 14, "value": 0.95 }] },
            { "property": "scale", "keyframes": [{ "frame": 0, "value": 0.85 }, { "frame": 24, "value": 1, "easing": "easeOutBack" }] }
          ]
        },
        {
          "id": "stars",
          "type": "group",
          "x": 96,
          "y": 392,
          "children": [
            {
              "id": "star-1",
              "type": "path",
              "d": "M0 -30 L7.58 -10.44 L28.53 -9.27 L12.27 3.99 L17.63 24.27 L0 12.9 L-17.63 24.27 L-12.27 3.99 L-28.53 -9.27 L-7.58 -10.44 Z",
              "fill": "{{accent2}}",
              "animations": [
                { "property": "scale", "keyframes": [{ "frame": 10, "value": 0 }, { "frame": 28, "value": 1, "easing": "easeOutBack" }] },
                { "property": "rotation", "keyframes": [{ "frame": 10, "value": -25 }, { "frame": 28, "value": 0, "easing": "land" }] }
              ]
            },
            {
              "id": "star-2",
              "type": "path",
              "d": "M0 -30 L7.58 -10.44 L28.53 -9.27 L12.27 3.99 L17.63 24.27 L0 12.9 L-17.63 24.27 L-12.27 3.99 L-28.53 -9.27 L-7.58 -10.44 Z",
              "x": 66,
              "fill": "{{accent2}}",
              "animations": [
                { "property": "scale", "keyframes": [{ "frame": 16, "value": 0 }, { "frame": 34, "value": 1, "easing": "easeOutBack" }] },
                { "property": "rotation", "keyframes": [{ "frame": 16, "value": -25 }, { "frame": 34, "value": 0, "easing": "land" }] }
              ]
            },
            {
              "id": "star-3",
              "type": "path",
              "d": "M0 -30 L7.58 -10.44 L28.53 -9.27 L12.27 3.99 L17.63 24.27 L0 12.9 L-17.63 24.27 L-12.27 3.99 L-28.53 -9.27 L-7.58 -10.44 Z",
              "x": 132,
              "fill": "{{accent2}}",
              "animations": [
                { "property": "scale", "keyframes": [{ "frame": 22, "value": 0 }, { "frame": 40, "value": 1, "easing": "easeOutBack" }] },
                { "property": "rotation", "keyframes": [{ "frame": 22, "value": -25 }, { "frame": 40, "value": 0, "easing": "land" }] }
              ]
            },
            {
              "id": "star-4",
              "type": "path",
              "d": "M0 -30 L7.58 -10.44 L28.53 -9.27 L12.27 3.99 L17.63 24.27 L0 12.9 L-17.63 24.27 L-12.27 3.99 L-28.53 -9.27 L-7.58 -10.44 Z",
              "x": 198,
              "fill": "{{accent2}}",
              "animations": [
                { "property": "scale", "keyframes": [{ "frame": 28, "value": 0 }, { "frame": 46, "value": 1, "easing": "easeOutBack" }] },
                { "property": "rotation", "keyframes": [{ "frame": 28, "value": -25 }, { "frame": 46, "value": 0, "easing": "land" }] }
              ]
            },
            {
              "id": "star-5",
              "type": "path",
              "d": "M0 -30 L7.58 -10.44 L28.53 -9.27 L12.27 3.99 L17.63 24.27 L0 12.9 L-17.63 24.27 L-12.27 3.99 L-28.53 -9.27 L-7.58 -10.44 Z",
              "x": 264,
              "fill": "{{accent2}}",
              "animations": [
                { "property": "scale", "keyframes": [{ "frame": 34, "value": 0 }, { "frame": 52, "value": 1, "easing": "easeOutBack" }] },
                { "property": "rotation", "keyframes": [{ "frame": 34, "value": -25 }, { "frame": 52, "value": 0, "easing": "land" }] }
              ]
            }
          ]
        },
        {
          "id": "score",
          "type": "text",
          "content": "{{score}}",
          "x": 888,
          "y": 372,
          "fontSize": 32,
          "fontWeight": 700,
          "textAlign": "right",
          "maxWidth": 96,
          "maxLines": 1,
          "color": "{{muted}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 44, "value": 0 }, { "frame": 60, "value": 1 }] }
          ]
        },
        {
          "id": "quote",
          "type": "text",
          "content": "{{quote}}",
          "x": 96,
          "y": 452,
          "fontSize": 56,
          "fontWeight": 500,
          "lineHeight": 1.34,
          "letterSpacing": -0.5,
          "maxWidth": 888,
          "maxLines": 4,
          "minFontSize": 38,
          "color": "{{text}}",
          "split": { "by": "lines", "preset": "rise", "stagger": 7, "duration": 26 }
        },
        {
          "id": "rule",
          "type": "rect",
          "x": 96,
          "y": 792,
          "width": 112,
          "height": 6,
          "radius": 3,
          "fill": "{{accent}}",
          "animations": [
            { "property": "width", "keyframes": [{ "frame": 40, "value": 0 }, { "frame": 64, "value": 112, "easing": "land" }] }
          ]
        },
        {
          "id": "avatar",
          "type": "circle",
          "x": 96,
          "y": 866,
          "width": 88,
          "fill": "{{accent}}",
          "animations": [
            { "property": "scale", "keyframes": [{ "frame": 52, "value": 0 }, { "frame": 74, "value": 1, "easing": "easeOutBack" }] }
          ]
        },
        {
          "id": "initials",
          "type": "text",
          "content": "{{initials}}",
          "x": 96,
          "y": 842,
          "fontSize": 32,
          "fontWeight": 800,
          "letterSpacing": 0.5,
          "textAlign": "center",
          "maxWidth": 88,
          "maxLines": 1,
          "color": "{{bg}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 58, "value": 0 }, { "frame": 76, "value": 1 }] }
          ]
        },
        {
          "id": "customer",
          "type": "text",
          "content": "{{customer}}",
          "x": 216,
          "y": 878,
          "fontSize": 38,
          "fontWeight": "{{headWeight}}",
          "maxWidth": 520,
          "maxLines": 1,
          "color": "{{text}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 54, "value": 0 }, { "frame": 74, "value": 1 }] },
            { "property": "y", "keyframes": [{ "frame": 54, "value": 896 }, { "frame": 78, "value": 878, "easing": "land" }] }
          ]
        },
        {
          "id": "company",
          "type": "text",
          "content": "{{company}}",
          "x": 216,
          "y": 926,
          "fontSize": 24,
          "maxWidth": 560,
          "maxLines": 1,
          "color": "{{muted}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 62, "value": 0 }, { "frame": 82, "value": 1 }] }
          ]
        }
      ]
    }
  ]
}
