{
  "version": "1.0",
  "id": "tutorial-steps",
  "name": "Tutorial steps",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0a1210",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#14211d",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#eefaf4",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#8fa89d",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#3ddc97",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#a6f0cc",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "dots",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "push",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "HOW TO",
      "description": "Small label"
    },
    "goal": {
      "type": "string",
      "default": "SET UP YOUR FIRST VIDEO",
      "description": "The goal, shown small on every step"
    },
    "title": {
      "type": "string",
      "default": "Your first video\nin four steps.",
      "description": "Opening title; a line break starts a new line"
    },
    "step1": {
      "type": "string",
      "default": "Write the brief",
      "description": "Step 1 title"
    },
    "step1d": {
      "type": "string",
      "default": "One sentence about who it is for and what it should say.",
      "description": "Step 1 detail"
    },
    "step2": {
      "type": "string",
      "default": "Pick a template",
      "description": "Step 2 title"
    },
    "step2d": {
      "type": "string",
      "default": "Start from one that matches the shape and length you need.",
      "description": "Step 2 detail"
    },
    "step3": {
      "type": "string",
      "default": "Fill in the words",
      "description": "Step 3 title"
    },
    "step3d": {
      "type": "string",
      "default": "Replace the placeholder lines with your own copy.",
      "description": "Step 3 detail"
    },
    "step4": {
      "type": "string",
      "default": "Render and share",
      "description": "Step 4 title"
    },
    "step4d": {
      "type": "string",
      "default": "Export the video and post it where your audience is.",
      "description": "Step 4 detail"
    },
    "result": {
      "type": "string",
      "default": "That is all it takes.",
      "description": "The closing line"
    },
    "url": {
      "type": "string",
      "default": "motionrender.dev/docs",
      "description": "Address"
    }
  },
