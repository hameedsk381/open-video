{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "case-study",
  "name": "Case study",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": 600,
  "background": {
    "type": "linear",
    "from": [0, 0],
    "to": [1920, 1080],
    "stops": [
      { "offset": 0, "color": "#07110f" },
      { "offset": 0.55, "color": "#0b1a17" },
      { "offset": 1, "color": "#060d0b" }
    ]
  },
  "variables": {
    "kicker": { "type": "string", "default": "CASE STUDY" },
    "client": { "type": "string", "default": "Northlight" },
    "headline": { "type": "string", "default": "A launch film in a\\nsingle afternoon", "description": "Promise; a line break starts a new line" },
    "stat1": { "type": "string", "default": "12×" },
    "stat1Label": { "type": "string", "default": "faster to a first cut" },
    "stat2": { "type": "string", "default": "68%" },
    "stat2Label": { "type": "string", "default": "less re-rendering" },
    "stat3": { "type": "string", "default": "1" },
    "stat3Label": { "type": "string", "default": "source file for every cut" },
    "quote": { "type": "string", "default": "We stopped rebuilding the same video for every format. One file, three ratios, done before lunch." },
    "quoteBy": { "type": "string", "default": "Mira Chen, Creative director" },
    "cta": { "type": "string", "default": "Read the story" },
    "accent": { "type": "color", "default": "#34d399", "description": "Numbers, rules and the button colour" }
  },
  "scenes": [
    {
      "id": "intro",
      "name": "Client and promise",
      "startFrame": 0,
      "durationFrames": 180,
      "transitionIn": { "type": "fade", "durationFrames": 12 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "glow",
          "type": "circle",
          "x": 1180,
          "y": -300,
          "width": 1100,
          "fill": "{{accent}}",
          "opacity": 0.14,
          "blur": 100,
          "animations": [
            { "property": "x", "keyframes": [{ "frame": 0, "value": 1220 }, { "frame": 180, "value": 1100, "easing": "drift" }] }
          ]
        },
        {
          "id": "kicker",
          "type": "text",
          "content": "{{kicker}}",
          "x": 150,
          "y": 190,
          "fontSize": 26,
          "fontWeight": 700,
          "letterSpacing": 8,
          "color": "{{accent}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 16, "value": 1 }] }
          ]
        },
        {
          "id": "client",
          "type": "text",
          "content": "{{client}}",
          "x": 146,
          "y": 290,
          "fontSize": 96,
          "fontWeight": 800,
          "letterSpacing": -3,
          "maxWidth": 1200,
          "maxLines": 1,
          "minFontSize": 56,
          "color": "#f0fdf9",
          "animations": [
            { "property": "y", "keyframes": [{ "frame": 0, "value": 320 }, { "frame": 30, "value": 290, "easing": "land" }] },
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 26, "value": 1 }] }
          ]
        },
        {
          "id": "rule",
          "type": "rect",
          "x": 150,
          "y": 430,
          "width": 220,
          "height": 8,
          "radius": 4,
          "fill": "{{accent}}",
          "animations": [
            { "property": "width", "keyframes": [{ "frame": 18, "value": 0 }, { "frame": 46, "value": 220, "easing": "land" }] }
          ]
        },
        {
          "id": "headline",
          "type": "text",
          "content": "{{headline}}",
          "x": 146,
          "y": 520,
          "fontSize": 126,
          "fontWeight": 800,
          "lineHeight": 0.98,
          "letterSpacing": -5,
          "maxWidth": 1500,
          "maxLines": 3,
          "minFontSize": 74,
          "color": "#ecfdf5",
          "split": { "by": "words", "preset": "rise", "stagger": 4, "duration": 26 }
        },
        {
          "id": "mark",
          "type": "path",
          "d": "M0 0 L120 0 M0 0 L0 120",
          "x": 1650,
          "y": 840,
          "stroke": "{{accent}}",
          "strokeWidth": 4,
          "opacity": 0.7
        }
      ]
    },
    {
      "id": "stats",
      "name": "Results",
      "startFrame": 180,
      "durationFrames": 240,
      "transitionIn": { "type": "slide", "direction": "left", "durationFrames": 18 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "stats-glow",
          "type": "circle",
          "x": -260,
          "y": 640,
          "width": 900,
          "fill": "{{accent}}",
          "opacity": 0.1,
          "blur": 90
        },
        {
          "id": "stats-kicker",
          "type": "text",
          "content": "THE RESULT",
          "x": 150,
          "y": 160,
          "fontSize": 26,
          "fontWeight": 700,
          "letterSpacing": 8,
          "color": "{{accent}}"
        },
        {
          "id": "stat-1",
          "type": "text",
          "content": "{{stat1}}",
          "x": 150,
          "y": 330,
          "fontSize": 150,
          "fontWeight": 800,
          "letterSpacing": -6,
          "maxWidth": 520,
          "maxLines": 1,
          "minFontSize": 86,
          "color": "#ecfdf5",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 14, "value": 0 }, { "frame": 34, "value": 1 }] },
            { "property": "y", "keyframes": [{ "frame": 14, "value": 360 }, { "frame": 42, "value": 330, "easing": "land" }] }
          ]
        },
        {
          "id": "stat-1-label",
          "type": "text",
          "content": "{{stat1Label}}",
          "x": 154,
          "y": 520,
          "fontSize": 32,
          "lineHeight": 1.35,
          "maxWidth": 460,
          "maxLines": 2,
          "color": "#8fb3a7",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 24, "value": 0 }, { "frame": 44, "value": 1 }] }
          ]
        },
        {
          "id": "stat-2",
          "type": "text",
          "content": "{{stat2}}",
          "x": 730,
          "y": 330,
          "fontSize": 150,
          "fontWeight": 800,
          "letterSpacing": -6,
          "maxWidth": 520,
          "maxLines": 1,
          "minFontSize": 86,
          "color": "#ecfdf5",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 28, "value": 0 }, { "frame": 48, "value": 1 }] },
            { "property": "y", "keyframes": [{ "frame": 28, "value": 360 }, { "frame": 56, "value": 330, "easing": "land" }] }
          ]
        },
        {
          "id": "stat-2-label",
          "type": "text",
          "content": "{{stat2Label}}",
          "x": 734,
          "y": 520,
          "fontSize": 32,
          "lineHeight": 1.35,
          "maxWidth": 460,
          "maxLines": 2,
          "color": "#8fb3a7",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 38, "value": 0 }, { "frame": 58, "value": 1 }] }
          ]
        },
        {
          "id": "stat-3",
          "type": "text",
          "content": "{{stat3}}",
          "x": 1310,
          "y": 330,
          "fontSize": 150,
          "fontWeight": 800,
          "letterSpacing": -6,
          "maxWidth": 520,
          "maxLines": 1,
          "minFontSize": 86,
          "color": "#ecfdf5",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 42, "value": 0 }, { "frame": 62, "value": 1 }] },
            { "property": "y", "keyframes": [{ "frame": 42, "value": 360 }, { "frame": 70, "value": 330, "easing": "land" }] }
          ]
        },
        {
          "id": "stat-3-label",
          "type": "text",
          "content": "{{stat3Label}}",
          "x": 1314,
          "y": 520,
          "fontSize": 32,
          "lineHeight": 1.35,
          "maxWidth": 460,
          "maxLines": 2,
          "color": "#8fb3a7",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 52, "value": 0 }, { "frame": 72, "value": 1 }] }
          ]
        },
        {
          "id": "stats-rule",
          "type": "rect",
          "x": 150,
          "y": 760,
          "width": 1620,
          "height": 2,
          "fill": "#1d3a33"
        }
      ]
    },
    {
      "id": "quote",
      "name": "Quote",
      "startFrame": 420,
      "durationFrames": 180,
      "transitionIn": { "type": "fade", "durationFrames": 14 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "quote-glow",
          "type": "circle",
          "x": 240,
          "y": 760,
          "width": 820,
          "fill": "{{accent}}",
          "opacity": 0.16,
          "blur": 100
        },
        {
          "id": "quote-mark",
          "type": "text",
          "content": "“",
          "x": 140,
          "y": 120,
          "fontSize": 260,
          "fontWeight": 800,
          "lineHeight": 1,
          "color": "{{accent}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 24, "value": 0.9 }] }
          ]
        },
        {
          "id": "quote",
          "type": "text",
          "content": "{{quote}}",
          "x": 150,
          "y": 400,
          "fontSize": 68,
          "fontWeight": 600,
          "lineHeight": 1.3,
          "letterSpacing": -1,
          "maxWidth": 1520,
          "maxLines": 4,
          "minFontSize": 44,
          "color": "#ecfdf5",
          "split": { "by": "lines", "preset": "rise", "stagger": 6, "duration": 24 }
        },
        {
          "id": "quote-by",
          "type": "text",
          "content": "{{quoteBy}}",
          "x": 150,
          "y": 760,
          "fontSize": 34,
          "fontWeight": 600,
          "maxWidth": 900,
          "maxLines": 1,
          "color": "{{accent}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 30, "value": 0 }, { "frame": 50, "value": 1 }] }
          ]
        },
        {
          "id": "cta",
          "type": "text",
          "content": "{{cta}} →",
          "x": 150,
          "y": 860,
          "fontSize": 38,
          "fontWeight": 700,
          "color": "#d1fae5",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 46, "value": 0 }, { "frame": 66, "value": 1 }] }
          ]
        },
        {
          "id": "mark",
          "type": "path",
          "d": "M0 0 L120 0 M0 0 L0 120",
          "x": 1650,
          "y": 840,
          "stroke": "{{accent}}",
          "strokeWidth": 4,
          "opacity": 0.7
        }
      ]
    }
  ]
}
