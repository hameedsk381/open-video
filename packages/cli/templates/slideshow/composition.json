{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "slideshow",
  "name": "Slideshow",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": {
    "type": "linear",
    "from": [0, 0],
    "to": [1920, 1080],
    "stops": [
      { "offset": 0, "color": "#070d18" },
      { "offset": 0.6, "color": "#0b1526" },
      { "offset": 1, "color": "#060a12" }
    ]
  },
  "variables": {
    "slides": {
      "type": "list",
      "description": "One scene per item; add or remove items to change the length",
      "items": {
        "title": { "type": "string", "default": "Untitled" },
        "body": { "type": "string", "default": "" }
      },
      "default": [
        { "title": "One source of truth", "body": "A composition is a JSON file. Every render reads the same file the same way." },
        { "title": "Frames, not guesses", "body": "Text, shapes and pictures are drawn at exact frames, so a second render matches the first." },
        { "title": "Built to be edited", "body": "Change a value, re-render, and only what you changed moves. Everything else stays put." }
      ]
    },
    "kicker": { "type": "string", "default": "HOW IT WORKS" },
    "footer": { "type": "string", "default": "Open Video Engine" },
    "accent": { "type": "color", "default": "#38bdf8", "description": "Number, rule and glow colour" }
  },
  "scenes": [
    {
      "repeat": "{{slides}}",
      "as": "slide",
      "each": [
        {
          "id": "slide-{{index + 1}}",
          "name": "{{slide.title}}",
          "durationFrames": 120,
          "transitionIn": { "type": "fade", "durationFrames": 12 },
          "transitionOut": { "type": "fade", "durationFrames": 12 },
          "layers": [
            {
              "id": "glow",
              "type": "circle",
              "x": 1240,
              "y": -260,
              "width": 1000,
              "fill": "{{accent}}",
              "opacity": 0.13,
              "blur": 90,
              "animations": [
                { "property": "x", "keyframes": [{ "frame": 0, "value": 1280 }, { "frame": 120, "value": 1160, "easing": "drift" }] }
              ]
            },
            {
              "id": "kicker",
              "type": "text",
              "content": "{{kicker}}",
              "x": 160,
              "y": 150,
              "fontSize": 26,
              "fontWeight": 700,
              "letterSpacing": 8,
              "color": "{{accent}}",
              "animations": [
                { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 14, "value": 1 }] }
              ]
            },
            {
              "id": "number",
              "type": "text",
              "content": "0{{index + 1}}",
              "x": 1600,
              "y": 120,
              "fontSize": 210,
              "fontWeight": 800,
              "letterSpacing": -8,
              "textAlign": "right",
              "color": "#122033",
              "animations": [
                { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 20, "value": 1 }] }
              ]
            },
            {
              "id": "title",
              "type": "text",
              "content": "{{slide.title}}",
              "x": 156,
              "y": 430,
              "fontSize": 104,
              "fontWeight": 800,
              "lineHeight": 1.02,
              "letterSpacing": -4,
              "maxWidth": 1300,
              "maxLines": 3,
              "minFontSize": 64,
              "color": "#f1f5f9",
              "split": { "by": "words", "preset": "rise", "stagger": 5, "duration": 24 }
            },
            {
              "id": "rule",
              "type": "rect",
              "x": 160,
              "y": 730,
              "width": 180,
              "height": 8,
              "radius": 4,
              "fill": "{{accent}}",
              "animations": [
                { "property": "width", "keyframes": [{ "frame": 16, "value": 0 }, { "frame": 40, "value": 180, "easing": "land" }] }
              ]
            },
            {
              "id": "body",
              "type": "text",
              "content": "{{slide.body}}",
              "x": 160,
              "y": 790,
              "fontSize": 40,
              "lineHeight": 1.45,
              "maxWidth": 1180,
              "maxLines": 3,
              "color": "#9fb3c8",
              "animations": [
                { "property": "opacity", "keyframes": [{ "frame": 24, "value": 0 }, { "frame": 46, "value": 1 }] }
              ]
            },
            {
              "id": "footer",
              "type": "text",
              "content": "{{footer}}",
              "x": 160,
              "y": 970,
              "fontSize": 24,
              "letterSpacing": 3,
              "color": "#64748b"
            },
            {
              "id": "dots",
              "type": "group",
              "x": 1600,
              "y": 966,
              "children": [
                {
                  "id": "dot-on",
                  "type": "circle",
                  "x": 0,
                  "y": 0,
                  "width": 12,
                  "fill": "{{accent}}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
