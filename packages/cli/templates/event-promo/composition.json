{
  "version": "1.0",
  "id": "event-promo",
  "name": "Event promo",
  "width": 1080,
  "height": 1350,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#120a1f",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#1d1230",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#faf5ff",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#a99bc0",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#ff5fa2",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#ffb3d4",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "slide",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "wipe",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "YOU ARE INVITED",
      "description": "Small label"
    },
    "event": {
      "type": "string",
      "default": "Motion\nSummit 26",
      "description": "Event name; a line break starts a new line"
    },
    "date": {
      "type": "string",
      "default": "12 NOV · 18:00",
      "description": "Date and time"
    },
    "place": {
      "type": "string",
      "default": "Online and in Berlin",
      "description": "Place"
    },
    "who": {
      "type": "string",
      "default": "WHO IS ON STAGE",
      "description": "Label above the speakers"
    },
    "a1": {
      "type": "string",
      "default": "Ada Okafor",
      "description": "Speaker 1"
    },
    "a1d": {
      "type": "string",
      "default": "Designing for motion",
      "description": "Speaker 1 topic"
    },
    "a2": {
