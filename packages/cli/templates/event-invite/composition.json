{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "event-invite",
  "name": "Event invite",
  "width": 1080,
  "height": 1350,
  "fps": 30,
  "durationFrames": 360,
  "background": {
    "type": "linear",
    "from": [0, 0],
    "to": [1080, 1350],
    "stops": [
      { "offset": 0, "color": "#0b0a1a" },
      { "offset": 0.6, "color": "#141233" },
      { "offset": 1, "color": "#0a0916" }
    ]
  },
  "variables": {
    "kicker": { "type": "string", "default": "YOU'RE INVITED" },
    "title": { "type": "string", "default": "Design\\nNight", "description": "Event name; a line break starts a new line" },
    "date": { "type": "string", "default": "Thu 14 May · 19:00" },
    "place": { "type": "string", "default": "The Studio, 12 Harbour Lane" },
    "detail": { "type": "string", "default": "An evening of short talks on type, motion and the things we make. Drinks after." },
    "cta": { "type": "string", "default": "Save your seat" },
    "accent": { "type": "color", "default": "#a78bfa", "description": "Glow, rule and button colour" }
  },
  "scenes": [
    {
      "id": "invite",
      "name": "Invitation",
      "startFrame": 0,
      "durationFrames": 240,
      "camera": {
        "animations": [
          { "property": "zoom", "keyframes": [{ "frame": 0, "value": 1 }, { "frame": 240, "value": 1.08, "easing": "drift" }] }
        ]
      },
      "transitionIn": { "type": "fade", "durationFrames": 12 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "glow-top",
          "type": "circle",
          "x": 520,
          "y": -320,
          "width": 980,
          "fill": "{{accent}}",
          "opacity": 0.18,
          "blur": 90
        },
        {
          "id": "glow-bottom",
          "type": "circle",
          "x": -240,
          "y": 1040,
          "width": 720,
          "fill": "#818cf8",
          "opacity": 0.12,
          "blur": 80
        },
        {
          "id": "kicker",
          "type": "text",
          "content": "{{kicker}}",
          "x": 92,
          "y": 170,
          "fontSize": 28,
          "fontWeight": 700,
          "letterSpacing": 9,
          "color": "{{accent}}",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 18, "value": 1 }] }
          ]
        },
        {
          "id": "title",
          "type": "text",
          "content": "{{title}}",
          "x": 88,
          "y": 380,
          "fontSize": 168,
          "fontWeight": 800,
          "lineHeight": 0.92,
          "letterSpacing": -7,
          "maxWidth": 920,
          "maxLines": 3,
          "minFontSize": 96,
          "color": "#f5f3ff",
          "split": { "by": "words", "preset": "rise", "stagger": 6, "duration": 28 }
        },
        {
          "id": "rule",
          "type": "rect",
          "x": 92,
          "y": 802,
          "width": 240,
          "height": 8,
          "radius": 4,
          "fill": "{{accent}}",
          "animations": [
            { "property": "width", "keyframes": [{ "frame": 20, "value": 0 }, { "frame": 50, "value": 240, "easing": "land" }] }
          ]
        },
        {
          "id": "date",
          "type": "text",
          "content": "{{date}}",
          "x": 92,
          "y": 862,
          "fontSize": 54,
          "fontWeight": 600,
          "maxWidth": 880,
          "maxLines": 1,
          "minFontSize": 34,
          "color": "#ede9fe",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 28, "value": 0 }, { "frame": 48, "value": 1 }] }
          ]
        },
        {
          "id": "place",
          "type": "text",
          "content": "{{place}}",
          "x": 92,
          "y": 936,
          "fontSize": 34,
          "maxWidth": 860,
          "maxLines": 2,
          "color": "#b9b1e8",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 36, "value": 0 }, { "frame": 56, "value": 1 }] }
          ]
        },
        {
          "id": "detail",
          "type": "text",
          "content": "{{detail}}",
          "x": 92,
          "y": 1050,
          "fontSize": 32,
          "lineHeight": 1.5,
          "maxWidth": 820,
          "maxLines": 4,
          "color": "#a9a1d6",
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 44, "value": 0 }, { "frame": 64, "value": 1 }] }
          ]
        },
        {
          "id": "dot",
          "type": "circle",
          "x": 930,
          "y": 220,
          "width": 54,
          "fill": "{{accent}}",
          "opacity": 0.9,
          "animations": [
            { "property": "scale", "keyframes": [{ "frame": 10, "value": 0 }, { "frame": 36, "value": 1, "easing": "easeOutBack" }] }
          ]
        }
      ]
    },
    {
      "id": "cta",
      "name": "Save your seat",
      "startFrame": 240,
      "durationFrames": 120,
      "camera": {
        "animations": [
          { "property": "zoom", "keyframes": [{ "frame": 0, "value": 1 }, { "frame": 120, "value": 1.08, "easing": "drift" }] }
        ]
      },
      "transitionIn": { "type": "zoom", "durationFrames": 16 },
      "transitionOut": { "type": "fade", "durationFrames": 12 },
      "layers": [
        {
          "id": "cta-glow",
          "type": "circle",
          "x": 160,
          "y": 780,
          "width": 760,
          "fill": "{{accent}}",
          "opacity": 0.2,
          "blur": 90
        },
        {
          "id": "cta-label",
          "type": "text",
          "content": "{{date}}",
          "x": 540,
          "y": 340,
          "fontSize": 34,
          "fontWeight": 600,
          "textAlign": "center",
          "letterSpacing": 2,
          "color": "#b9b1e8"
        },
        {
          "id": "cta-title",
          "type": "text",
          "content": "{{title}}",
          "x": 540,
          "y": 430,
          "fontSize": 112,
          "fontWeight": 800,
          "lineHeight": 0.98,
          "letterSpacing": -4,
          "textAlign": "center",
          "maxWidth": 900,
          "maxLines": 2,
          "minFontSize": 62,
          "color": "#f5f3ff"
        },
        {
          "id": "button",
          "type": "rect",
          "x": 280,
          "y": 760,
          "width": 520,
          "height": 132,
          "radius": 66,
          "fill": "{{accent}}",
          "animations": [
            { "property": "scale", "keyframes": [{ "frame": 12, "value": 0.9 }, { "frame": 34, "value": 1, "easing": "easeOutBack" }] }
          ]
        },
        {
          "id": "button-text",
          "type": "text",
          "content": "{{cta}}",
          "x": 540,
          "y": 802,
          "fontSize": 42,
          "fontWeight": 700,
          "textAlign": "center",
          "color": "#160f33"
        },
        {
          "id": "place-small",
          "type": "text",
          "content": "{{place}}",
          "x": 540,
          "y": 970,
          "fontSize": 30,
          "textAlign": "center",
          "maxWidth": 820,
          "maxLines": 2,
          "color": "#b9b1e8"
        }
      ]
    }
  ]
}
