{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "saas-launch",
  "name": "Modern SaaS Launch (React)",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": 180,
  "background": "#080c14",
  "scenes": [
    {
      "id": "main",
      "name": "Main",
      "startFrame": 0,
      "durationFrames": 180,
      "layers": [
        {
          "id": "react",
          "type": "react",
          "src": "video.bundle.js",
          "width": 1920,
          "height": 1080,
          "durationInFrames": 180,
          "props": {
            "badge": "AI ENGINE 2.0",
            "title": "Design Videos in React",
            "subtitle": "Frame-accurate motion graphics, spring physics, and headless render speed.",
            "metric": 10,
            "metricLabel": "Faster Video Rendering",
            "url": "openvideo.dev/engine"
          }
        },
        {
          "id": "audio-1",
          "type": "audio",
          "startFrame": 0,
          "endFrame": 75,
          "src": "sfx:whoosh",
          "trimStart": 0,
          "volume": 0.6,
          "playbackRate": 1,
          "loop": false
        },
        {
          "id": "audio-2",
          "type": "audio",
          "startFrame": 75,
          "endFrame": 135,
          "src": "sfx:pop",
          "trimStart": 0,
          "volume": 0.5,
          "playbackRate": 1,
          "loop": false
        },
        {
          "id": "audio-3",
          "type": "audio",
          "startFrame": 135,
          "endFrame": 180,
          "src": "sfx:ding",
          "trimStart": 0,
          "volume": 0.5,
          "playbackRate": 1,
          "loop": false
        }
      ]
    }
  ]
}
