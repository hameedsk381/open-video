{
  "version": "1.0",
  "id": "product-spotlight",
  "name": "Product spotlight",
  "width": 1080,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0d1117",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#171d27",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#f1f5f9",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#8a97a8",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#2ee6a6",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#a8f5d9",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "NOW AVAILABLE",
      "description": "Small label above the name"
    },
    "product": {
      "type": "string",
      "default": "Aero One",
      "description": "Product name"
    },
    "promise": {
      "type": "string",
      "default": "The lightest way to carry everything.",
      "description": "One-line promise"
    },
    "f1": {
      "type": "string",
      "default": "Featherweight",
      "description": "Feature 1"
    },
    "f1d": {
      "type": "string",
      "default": "Under 300 grams, fully loaded.",
      "description": "Feature 1 detail"
    },
    "f2": {
      "type": "string",
      "default": "Weatherproof",
      "description": "Feature 2"
    },
    "f2d": {
      "type": "string",
      "default": "Sealed seams, tested in the rain.",
      "description": "Feature 2 detail"
    },
    "f3": {
      "type": "string",
      "default": "Built to last",
      "description": "Feature 3"
    },
    "f3d": {
      "type": "string",
      "default": "A ten-year guarantee, no questions.",
      "description": "Feature 3 detail"
    },
    "price": {
      "type": "string",
      "default": "$129",
      "description": "Price"
    },
    "priceNote": {
      "type": "string",
      "default": "Free shipping this week",
      "description": "Line under the price"
    },
    "button": {
      "type": "string",
      "default": "Get it now",
      "description": "Button text"
    },
    "url": {
      "type": "string",
      "default": "example.com/aero",
      "description": "Address"
    }
  },
