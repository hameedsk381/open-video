{
  "version": "1.0",
  "id": "hook-reel",
  "name": "Hook reel",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0a0a0b",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#16161a",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#f4f1ea",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#9a968c",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#ff4a1c",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#ffb199",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "brand": {
      "type": "string",
      "default": "MOTIONRENDER",
      "description": "Small brand line in the top corner"
    },
    "kicker": {
      "type": "string",
      "default": "NEW · 2026",
      "description": "Small label above the headline"
    },
    "title": {
      "type": "string",
      "default": "Make it\nmove.",
      "description": "The hook; a line break starts a new line"
    },
    "detail": {
      "type": "string",
      "default": "One brief in. A finished video out. Every frame checked.",
      "description": "One sentence under the hook"
    },
    "stepsTitle": {
      "type": "string",
      "default": "HOW IT WORKS",
      "description": "Label above the three steps"
    },
    "step1Title": {
      "type": "string",
      "default": "Write the brief",
      "description": "Step 1 title"
    },
    "step1Body": {
      "type": "string",
      "default": "Say what it is for in a sentence.",
      "description": "Step 1 detail"
    },
    "step2Title": {
      "type": "string",
      "default": "Check the plan",
      "description": "Step 2 title"
    },
    "step2Body": {
      "type": "string",
      "default": "Every scene and line, before it renders.",
      "description": "Step 2 detail"
    },
    "step3Title": {
      "type": "string",
      "default": "Render it",
      "description": "Step 3 title"
    },
    "step3Body": {
      "type": "string",
      "default": "Frame-exact, the same every time.",
      "description": "Step 3 detail"
    },
    "ctaKicker": {
      "type": "string",
      "default": "READY?",
      "description": "Small label above the call to action"
    },
    "cta": {
      "type": "string",
      "default": "Start\nnow.",
      "description": "The call to action; a line break starts a new line"
    },
    "ctaButton": {
      "type": "string",
      "default": "Try it free",
      "description": "Text on the button"
    },
    "url": {
      "type": "string",
      "default": "motionrender.dev",
      "description": "Address under the button"
    }
  },
