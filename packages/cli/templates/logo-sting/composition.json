{
  "version": "1.0",
  "id": "logo-sting",
  "name": "Logo sting",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#07070a",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#16161a",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#f4f1ea",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#9a968c",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#7c5cff",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#c4b5ff",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "name": {
      "type": "string",
      "default": "MOTIONRENDER",
      "description": "The brand name"
    },
    "tagline": {
      "type": "string",
      "default": "Video, written as code.",
      "description": "The tagline"
    }
  },
  "scenes": [
    {
      "id": "sting",
      "name": "Sting",
      "durationFrames": 120,
      "camera": {
        "animations": [
          {
            "property": "zoom",
            "keyframes": [
              {
                "frame": 0,
                "value": 1
              },
              {
                "frame": 120,
                "value": 1.04,
                "easing": "drift"
              }
            ]
          }
        ]
      },
      "layers": [
        {
          "id": "aurora-a",
          "type": "circle",
          "x": 1497.6000000000001,
          "y": 129.6,
          "width": 1440,
          "fill": "{{accent}}",
          "opacity": 0.28600000000000003,
          "blur": 120,
          "animations": [
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1497.6000000000001
                },
                {
                  "frame": 120,
                  "value": 1228.8,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 129.6
                },
                {
                  "frame": 120,
                  "value": 216,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "aurora-b",
          "type": "circle",
          "x": 192,
          "y": 993.6,
          "width": 1152,
          "fill": "{{accent2}}",
          "opacity": 0.169,
          "blur": 130,
          "animations": [
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 192
                },
                {
                  "frame": 120,
                  "value": 460.79999999999995,
                  "easing": "drift"
                }
              ]
            },
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 993.6
                },
                {
                  "frame": 120,
                  "value": 885.5999999999999,
                  "easing": "drift"
                }
              ]
            }
          ]
        },
        {
          "id": "vignette",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 1920,
          "height": 1080,
          "radius": 0,
          "fill": {
            "type": "radial",
            "center": [
              960,
              540
            ],
            "radius": 1211.598943545264,
            "stops": [
              {
                "offset": 0.45,
                "color": "{{bg}}00"
              },
              {
                "offset": 1,
                "color": "{{bg}}cc"
              }
            ]
          }
        },
        {
          "id": "ring0",
          "type": "circle",
          "x": 960,
          "y": 540,
          "width": 300,
          "fill": "#00000000",
          "stroke": "{{accent}}",
          "strokeWidth": 3,
          "opacity": 0,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.4
                },
                {
                  "frame": 60,
                  "value": 3.2,
                  "easing": "land"
                }
              ]
            },
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 8,
                  "value": 0.7
                },
                {
                  "frame": 60,
                  "value": 0,
                  "easing": "exit"
                }
              ]
            }
          ]
        },
        {
          "id": "ring1",
          "type": "circle",
          "x": 960,
          "y": 540,
          "width": 300,
          "fill": "#00000000",
          "stroke": "{{text}}",
          "strokeWidth": 1,
          "opacity": 0,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 6,
                  "value": 0.4
                },
                {
                  "frame": 66,
                  "value": 4.2,
                  "easing": "land"
                }
              ]
            },
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 6,
                  "value": 0
                },
                {
                  "frame": 14,
                  "value": 0.25
                },
                {
                  "frame": 66,
                  "value": 0,
                  "easing": "exit"
                }
              ]
            }
          ]
        },
        {
          "id": "ring2",
          "type": "circle",
          "x": 960,
          "y": 540,
          "width": 300,
          "fill": "#00000000",
          "stroke": "{{text}}",
          "strokeWidth": 1,
          "opacity": 0,
          "animations": [
            {
              "property": "scale",
              "keyframes": [
                {
                  "frame": 12,
                  "value": 0.4
                },
                {
                  "frame": 72,
                  "value": 5.2,
                  "easing": "land"
                }
              ]
            },
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 12,
                  "value": 0
                },
                {
                  "frame": 20,
                  "value": 0.25
                },
                {
                  "frame": 72,
                  "value": 0,
                  "easing": "exit"
                }
              ]
            }
          ]
        },
        {
          "id": "name",
          "type": "text",
          "content": "{{name}}",
          "x": 960,
          "y": 440,
          "fontSize": 160,
          "fontFamily": "{{fontDisplay}}",
          "fontWeight": "{{headWeight}}",
          "color": "{{text}}",
          "letterSpacing": -4,
          "lineHeight": 0.96,
          "maxWidth": 1600,
          "maxLines": 1,
          "minFontSize": 70,
          "textAlign": "center",
          "split": {
            "by": "letters",
            "preset": "{{motion}}",
            "stagger": 2,
            "duration": 20
          },
          "startFrame": 14
        },
        {
          "id": "line",
          "type": "rect",
          "x": 780,
          "y": 640,
          "width": 1,
          "height": 4,
          "radius": 2,
          "fill": "{{accent}}",
          "animations": [
            {
              "property": "width",
              "keyframes": [
                {
                  "frame": 40,
                  "value": 0
                },
                {
                  "frame": 64,
                  "value": 360,
                  "easing": "land"
                }
              ]
            }
          ]
        },
        {
          "id": "tagline",
          "type": "text",
          "content": "{{tagline}}",
          "x": 960,
          "y": 680,
          "fontSize": 36,
          "fontFamily": "{{fontBody}}",
          "fontWeight": 500,
          "color": "{{muted}}",
          "letterSpacing": 2,
          "textAlign": "center",
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 52,
                  "value": 0
                },
                {
                  "frame": 66,
                  "value": 1,
                  "easing": "glide"
                }
              ]
            },
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 52,
                  "value": 696
                },
                {
                  "frame": 72,
                  "value": 680,
                  "easing": "land"
                }
              ]
            }
          ]
        },
        {
          "id": "sfx-whoosh-2",
          "type": "audio",
          "src": "sfx:whoosh",
          "startFrame": 2,
          "volume": 0.45
        },
        {
          "id": "sfx-thump-18",
          "type": "audio",
          "src": "sfx:thump",
          "startFrame": 18,
          "volume": 0.6
        },
        {
          "id": "sfx-ding-56",
          "type": "audio",
          "src": "sfx:ding",
          "startFrame": 56,
          "volume": 0.35
        }
      ]
    }
  ]
}
