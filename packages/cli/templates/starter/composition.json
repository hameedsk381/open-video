{
  "version": "1.0",
  "id": "starter",
  "name": "Starter",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": "auto",
  "background": "{{bg}}",
  "texture": {
    "type": "{{texture}}",
    "color": "{{textureColor}}",
    "opacity": "{{textureOpacity}}",
    "scale": 56
  },
  "export": {
    "format": "mp4",
    "loudness": -16
  },
  "variables": {
    "bg": {
      "type": "color",
      "default": "#0c0d10",
      "description": "Theme: page background (a 6-digit hex)"
    },
    "surface": {
      "type": "color",
      "default": "#16161a",
      "description": "Theme: raised surfaces and cards"
    },
    "text": {
      "type": "color",
      "default": "#f4f1ea",
      "description": "Theme: main text"
    },
    "muted": {
      "type": "color",
      "default": "#9a968c",
      "description": "Theme: secondary text"
    },
    "accent": {
      "type": "color",
      "default": "#5b8cff",
      "description": "Theme: the one signal colour"
    },
    "accent2": {
      "type": "color",
      "default": "#b6caff",
      "description": "Theme: a softer partner for the accent"
    },
    "radius": {
      "type": "number",
      "default": 28,
      "description": "Theme: corner radius of cards and buttons"
    },
    "headWeight": {
      "type": "number",
      "default": 800,
      "description": "Theme: weight of headlines"
    },
    "fontDisplay": {
      "type": "string",
      "default": "Archivo",
      "description": "Theme: headline font"
    },
    "fontBody": {
      "type": "string",
      "default": "Inter",
      "description": "Theme: body font"
    },
    "texture": {
      "type": "string",
      "default": "none",
      "description": "Theme: background texture: none, grid, dots, scanlines or paper"
    },
    "textureColor": {
      "type": "color",
      "default": "#ffffff",
      "description": "Theme: texture ink"
    },
    "textureOpacity": {
      "type": "number",
      "default": 0.05,
      "description": "Theme: texture strength"
    },
    "motion": {
      "type": "string",
      "default": "rise",
      "description": "Theme: how headlines arrive: rise, slide, pop or blur"
    },
    "transition": {
      "type": "string",
      "default": "fade",
      "description": "Theme: how scenes change: fade, zoom, wipe or push"
    },
    "kicker": {
      "type": "string",
      "default": "INTRODUCING",
      "description": "Small label above the title"
    },
    "title": {
      "type": "string",
      "default": "Say it once,\nclearly.",
      "description": "The title; a line break starts a new line"
    },
    "subtitle": {
      "type": "string",
      "default": "A short video that explains one idea.",
      "description": "One line under the title"
    },
    "pointsTitle": {
      "type": "string",
      "default": "Three things to know",
      "description": "Heading of the points"
    },
    "p1": {
      "type": "string",
      "default": "It is fast",
      "description": "Point 1"
    },
    "p1d": {
      "type": "string",
      "default": "From brief to render in minutes.",
      "description": "Point 1 detail"
    },
    "p2": {
      "type": "string",
      "default": "It is exact",
      "description": "Point 2"
    },
    "p2d": {
      "type": "string",
      "default": "Every frame is the same, every time.",
      "description": "Point 2 detail"
    },
    "p3": {
      "type": "string",
      "default": "It is yours",
      "description": "Point 3"
    },
    "p3d": {
      "type": "string",
      "default": "Plain files you can edit and keep.",
      "description": "Point 3 detail"
    },
    "closing": {
      "type": "string",
      "default": "Make something worth watching.",
      "description": "The closing line"
    },
    "url": {
      "type": "string",
      "default": "motionrender.dev",
      "description": "Address under the closing line"
    }
