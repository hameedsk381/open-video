{
  "$schema": "./composition.schema.json",
  "version": "1.0",
  "id": "starter",
  "name": "Starter",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationFrames": 150,
  "variables": {
    "title": { "type": "string", "default": "Hello,\nOpen Video Engine", "description": "Headline; a line break in the value starts a new line" },
    "tagline": { "type": "string", "default": "Edit composition.json to begin" },
    "accent": { "type": "color", "default": "#4f46e5", "description": "Colour of the glow" }
  },
  "assets": [
    { "id": "logo", "type": "image", "src": "./assets/logo.svg" }
  ],
  "scenes": [
    {
      "id": "intro",
      "name": "Intro",
      "startFrame": 0,
      "durationFrames": 150,
      "transitionIn": { "type": "fade", "durationFrames": 15 },
      "layers": [
        { "id": "background", "type": "rect", "width": 1920, "height": 1080, "fill": "#0f172a", "zIndex": 0 },
        {
          "id": "glow",
          "type": "circle",
          "x": 1580,
          "y": 300,
          "width": 640,
          "fill": "{{accent}}",
          "opacity": 0.5,
          "zIndex": 1,
          "animations": [
            { "property": "scale", "keyframes": [{ "frame": 0, "value": 0.8 }, { "frame": 75, "value": 1.1, "easing": "easeInOut" }], "repeat": 1, "reverse": true }
          ]
        },
        {
          "id": "logo",
          "type": "image",
          "src": "logo",
          "x": 160,
          "y": 220,
          "width": 160,
          "height": 160,
          "objectFit": "contain",
          "zIndex": 2,
          "animations": [
            { "property": "rotation", "keyframes": [{ "frame": 0, "value": -90 }, { "frame": 30, "value": 0, "easing": "easeOut" }] },
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 20, "value": 1 }] }
          ]
        },
        {
          "id": "title",
          "type": "text",
          "content": "{{title}}",
          "x": 160,
          "y": 440,
          "fontSize": 110,
          "maxWidth": 1000,
          "maxLines": 2,
          "minFontSize": 56,
          "lineHeight": 1.1,
          "color": "#ffffff",
          "zIndex": 3,
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 10, "value": 0 }, { "frame": 40, "value": 1, "easing": "easeOut" }] },
            { "property": "y", "keyframes": [{ "frame": 10, "value": 500 }, { "frame": 40, "value": 440, "easing": "easeOut" }] }
          ]
        },
        {
          "id": "tagline",
          "type": "group",
          "x": 160,
          "y": 740,
          "startFrame": 45,
          "zIndex": 3,
          "animations": [
            { "property": "opacity", "keyframes": [{ "frame": 0, "value": 0 }, { "frame": 20, "value": 1 }] }
          ],
          "children": [
            { "id": "pill", "type": "rect", "width": 620, "height": 84, "radius": 42, "fill": "#1e293b" },
            { "id": "tagline-text", "type": "text", "content": "{{tagline}}", "x": 36, "y": 24, "fontSize": 36, "maxWidth": 548, "maxLines": 1, "minFontSize": 22, "color": "#a5b4fc" }
          ]
        }
      ]
    }
  ]
}
