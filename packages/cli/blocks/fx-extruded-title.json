{
  "id": "fx-extruded-title",
  "name": "Extruded title",
  "category": "effect",
  "kind": "overlay",
  "durationFrames": 150,
  "description": "A big title with a solid 3D-looking depth made of stacked copies, that turns into place. In front of the picture, not behind the subject.",
  "params": {
    "title": {
      "type": "string",
      "default": "BUILD. COMPOSE. RENDER."
    }
  },
  "layers": [
    {
      "id": "extrusion",
      "type": "group",
      "x": 0,
      "y": "{{round(canvas.height * 0.58)}}",
      "width": "{{canvas.width}}",
      "height": "{{round(min(canvas.width, canvas.height) * 0.4)}}",
      "originX": "center",
      "originY": "center",
      "animations": [
        {
          "property": "rotation",
          "keyframes": [
            {
              "frame": 0,
              "value": -6,
              "easing": "land"
            },
            {
              "frame": 26,
              "value": 0
            }
          ]
        },
        {
          "property": "scale",
          "keyframes": [
            {
              "frame": 0,
              "value": 0.6,
              "easing": "pop"
            },
            {
              "frame": 22,
              "value": 1
            }
          ]
        },
        {
          "property": "opacity",
          "keyframes": [
            {
              "frame": 0,
              "value": 0
            },
            {
              "frame": 8,
              "value": 1
            }
          ]
        }
      ],
