          "x": "{{round(canvas.width * 0.5) + 14 * round(min(canvas.width, canvas.height) * 0.0035)}}",
          "y": "{{14 * round(min(canvas.width, canvas.height) * 0.0035)}}",
          "textAlign": "center",
          "fontWeight": 900,
          "maxWidth": "{{round(canvas.width * 0.9)}}",
