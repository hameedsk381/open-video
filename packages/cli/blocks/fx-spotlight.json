{
  "id": "fx-spotlight",
  "name": "Cinematic spotlight",
  "category": "effect",
  "kind": "scene",
  "durationFrames": 180,
  "transition": {
    "type": "fade",
    "durationFrames": 12
  },
  "description": "Your footage darkened to a near-black set with an electric-blue diagonal light beam, soft haze, drifting particles and a slow push-in, with glowing title type. The title is in front of the subject.",
  "params": {
    "footage": {
      "type": "string",
      "default": "",
      "description": "The video to put the effect on (asset id or relative path); the theme background shows without one"
    },
    "title": {
      "type": "string",
      "default": "OPEN VIDEO ENGINE"
    },
    "subtitle": {
      "type": "string",
      "default": "CREATE WITHOUT LIMITS"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "fill": "{{bg}}"
    },
    {
      "if": "{{footage}}",
      "id": "footage",
      "type": "video",
      "src": "{{footage}}",
      "objectFit": "cover",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}"
    },
    {
      "id": "dim",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "fill": "#04060f",
      "opacity": 0.62
    },
    {
      "id": "haze-1",
      "type": "circle",
      "x": "{{round(canvas.width * 0.2)}}",
      "y": "{{round(canvas.height * 0.3)}}",
      "width": "{{round(min(canvas.width, canvas.height) * 1.2)}}",
      "fill": "{{accent}}",
      "opacity": 0.2,
      "blur": 150,
      "animations": [
        {
          "property": "x",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.width * 0.2)}}"
            },
            {
              "frame": 180,
              "value": "{{round(canvas.width * 0.45)}}",
              "easing": "drift"
            }
          ]
        }
      ]
    },
    {
      "id": "haze-2",
      "type": "circle",
      "x": "{{round(canvas.width * 0.85)}}",
      "y": "{{round(canvas.height * 0.7)}}",
      "width": "{{round(min(canvas.width, canvas.height) * 1)}}",
      "fill": "{{accent2}}",
      "opacity": 0.12,
      "blur": 150,
      "animations": [
        {
          "property": "x",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.width * 0.85)}}"
            },
            {
              "frame": 180,
              "value": "{{round(canvas.width * 0.55)}}",
              "easing": "drift"
            }
          ]
        }
      ]
    },
    {
      "id": "beam",
      "type": "rect",
      "x": "{{round(canvas.width * 0.45)}}",
      "y": "{{-round(canvas.height * 0.2)}}",
      "width": "{{round(min(canvas.width, canvas.height) * 0.26)}}",
      "height": "{{round(canvas.height * 1.5)}}",
      "rotation": 24,
      "originX": "center",
      "originY": 0,
      "fill": {
        "type": "linear",
        "from": [
          0,
          0
        ],
        "to": [
          0,
          "{{round(canvas.height * 1.5)}}"
        ],
        "stops": [
          {
            "offset": 0,
            "color": "rgba(120,160,255,0.55)"
          },
          {
            "offset": 1,
            "color": "rgba(120,160,255,0)"
          }
        ]
      },
      "blendMode": "screen",
      "blur": 24,
      "animations": [
        {
          "property": "opacity",
          "keyframes": [
            {
              "frame": 0,
              "value": 0
            },
            {
              "frame": 30,
              "value": 0.85
            }
          ]
        },
        {
          "property": "x",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.width * 0.35)}}"
            },
            {
              "frame": 180,
              "value": "{{round(canvas.width * 0.6)}}",
              "easing": "drift"
            }
          ]
        }
      ]
    },
