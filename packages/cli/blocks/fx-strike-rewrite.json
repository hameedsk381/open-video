{
  "id": "fx-strike-rewrite",
  "name": "Strike and rewrite",
  "category": "effect",
  "kind": "overlay",
  "durationFrames": 120,
  "description": "An old statement in white, struck through in red, with the corrected statement rising in beneath it in the accent colour.",
  "params": {
    "old": {
      "type": "string",
      "default": "Edit every frame by hand"
    },
    "corrected": {
      "type": "string",
      "default": "Describe the video once"
    }
  },
  "files": [
    "support/fx.bundle.js"
  ],
  "layers": [
    {
      "id": "rewrite",
      "type": "react",
      "src": "fx.bundle.js",
      "width": "{{round(canvas.width * 0.88)}}",
      "height": "{{round(min(canvas.width, canvas.height) * 0.3)}}",
      "durationInFrames": 120,
      "props": {
        "effect": "rewrite",
        "old": "{{old}}",
        "corrected": "{{corrected}}",
        "accent2": "{{accent2}}",
        "unit": "{{round(min(canvas.width, canvas.height))}}"
      },
      "x": "{{round(canvas.width * 0.06)}}",
      "y": "{{round(canvas.height * 0.5)}}"
    },
    {
      "id": "sfx-1",
      "type": "audio",
      "src": "sfx:tick",
      "startFrame": 24,
      "volume": 0.35
    },
    {
      "id": "sfx-2",
      "type": "audio",
      "src": "sfx:ding",
      "startFrame": 52,
      "volume": 0.3
    }
  ]
}
