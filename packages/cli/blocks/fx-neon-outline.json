{
  "id": "fx-neon-outline",
  "name": "Neon outline",
  "category": "effect",
  "kind": "scene",
  "durationFrames": 150,
  "transition": {
    "type": "fade",
    "durationFrames": 12
  },
  "description": "A glowing neon outline around the speaker, with a band of light scanning down the figure. Needs a matte of the speaker.",
  "params": {
    "footage": {
      "type": "string",
      "default": "",
      "description": "Your video (asset id or relative path)"
    },
    "matte": {
      "type": "string",
      "default": "",
      "description": "A matte video or picture of the speaker: white where the speaker is. Make it with rembg, Robust Video Matting or an editor."
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "fill": "{{bg}}"
    },
    {
      "if": "{{footage}}",
      "id": "footage",
      "type": "video",
      "src": "{{footage}}",
      "objectFit": "cover",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}"
    },
