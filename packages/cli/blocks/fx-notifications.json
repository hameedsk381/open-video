    "title2": {
      "type": "string",
      "default": "Schema validated"
    },
    "body2": {
      "type": "string",
      "default": "No errors found"
    },
    "title3": {
      "type": "string",
      "default": "Video exported"
    },
    "body3": {
      "type": "string",
      "default": "out.mp4 is ready"
