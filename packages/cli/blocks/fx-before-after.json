{
  "id": "fx-before-after",
  "name": "Before and after",
  "category": "effect",
  "kind": "scene",
  "durationFrames": 180,
  "transition": {
    "type": "fade",
    "durationFrames": 12
  },
  "description": "A slider sweeps across your footage: the left side is plain and desaturated, the right side the graded version, with a glowing handle and labels.",
  "params": {
    "footage": {
      "type": "string",
      "default": "",
      "description": "The video to put the effect on (asset id or relative path); the theme background shows without one"
    },
    "before": {
      "type": "string",
      "default": "BEFORE"
    },
    "after": {
      "type": "string",
      "default": "AFTER"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "fill": "{{bg}}"
    },
    {
      "if": "{{footage}}",
      "id": "footage",
      "type": "video",
      "src": "{{footage}}",
      "objectFit": "cover",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "filter": "grayscale(0.85) brightness(0.9)"
    },
    {
      "id": "revealed",
      "type": "group",
      "x": "{{round(canvas.width * 1)}}",
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "clip": {
        "x": 0,
        "y": 0,
        "width": "{{canvas.width}}",
        "height": "{{canvas.height}}"
      },
      "animations": [
        {
          "property": "x",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.width * 1)}}"
            },
            {
              "frame": 20,
              "value": "{{round(canvas.width * 1)}}"
            },
            {
              "frame": 110,
              "value": "{{round(canvas.width * 0.12)}}",
              "easing": "glide"
            },
            {
              "frame": 150,
              "value": "{{round(canvas.width * 0.12)}}"
            },
            {
              "frame": 176,
              "value": "{{round(canvas.width * 0.5)}}",
              "easing": "glide"
            }
          ]
        }
      ],
      "children": [
        {
          "id": "bg",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "fill": "{{bg}}"
        },
        {
          "if": "{{footage}}",
          "id": "after-footage",
          "type": "video",
          "src": "{{footage}}",
          "objectFit": "cover",
          "x": 0,
          "y": 0,
          "width": "{{canvas.width}}",
          "height": "{{canvas.height}}",
          "filter": "saturate(1.3) contrast(1.1) brightness(1.05)",
          "animations": [
            {
              "property": "x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": "{{-round(canvas.width * 1)}}"
                },
                {
                  "frame": 20,
                  "value": "{{-round(canvas.width * 1)}}"
                },
                {
                  "frame": 110,
                  "value": "{{-round(canvas.width * 0.12)}}",
                  "easing": "glide"
                },
                {
                  "frame": 150,
                  "value": "{{-round(canvas.width * 0.12)}}"
                },
                {
                  "frame": 176,
                  "value": "{{-round(canvas.width * 0.5)}}",
                  "easing": "glide"
                }
              ]
            }
          ]
        },
        {
          "id": "handle",
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 6,
          "height": "{{canvas.height}}",
          "fill": "#ffffff",
          "shadow": {
            "color": "#ffffff",
            "blur": 20,
            "offsetX": 0,
            "offsetY": 0
          }
        },
        {
          "id": "knob",
          "type": "circle",
          "x": 3,
          "y": "{{round(canvas.height * 0.5)}}",
          "width": "{{round(min(canvas.width, canvas.height) * 0.09)}}",
          "fill": "{{accent}}",
          "stroke": "#ffffff",
          "strokeWidth": 4
        }
      ]
    },
    {
      "id": "before",
      "type": "text",
      "content": "{{before}}",
      "fontSize": "{{round(min(canvas.width, canvas.height) * 0.035)}}",
      "color": "#ffffff",
      "x": "{{round(canvas.width * 0.05)}}",
      "y": "{{round(canvas.height * 0.06)}}",
      "fontWeight": 800,
      "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
      "shadow": {
        "color": "#000000aa",
        "blur": 10,
        "offsetX": 0,
        "offsetY": 3
      }
    },
    {
      "id": "after",
      "type": "text",
      "content": "{{after}}",
      "fontSize": "{{round(min(canvas.width, canvas.height) * 0.035)}}",
      "color": "#ffffff",
      "x": "{{round(canvas.width * 0.95)}}",
      "y": "{{round(canvas.height * 0.06)}}",
      "textAlign": "right",
      "fontWeight": 800,
      "letterSpacing": "{{round(min(canvas.width, canvas.height) * 0.004)}}",
      "shadow": {
        "color": "#000000aa",
        "blur": 10,
        "offsetX": 0,
        "offsetY": 3
      }
    },
    {
      "id": "sfx-1",
      "type": "audio",
      "src": "sfx:whoosh",
      "startFrame": 20,
      "volume": 0.35
    }
  ]
}
