{
  "id": "section-title",
  "name": "Section title",
  "category": "title",
  "kind": "scene",
  "durationFrames": 75,
  "transition": {
    "type": "push",
    "durationFrames": 16,
    "direction": "left",
    "easing": "glide"
  },
  "description": "A short divider: a big number and a section name.",
  "params": {
    "number": {
      "type": "string",
      "default": "01"
    },
    "title": {
      "type": "string",
      "default": "The setup"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": "{{canvas.width}}",
      "height": "{{canvas.height}}",
      "fill": "{{bg}}"
    },
    {
      "id": "glow",
      "type": "circle",
      "x": "{{round(canvas.width * 0.8)}}",
      "y": "{{round(canvas.height * 0.1)}}",
      "width": "{{round(min(canvas.width, canvas.height) * 1.1)}}",
      "fill": "{{accent}}",
      "opacity": 0.12,
      "blur": 120,
      "animations": [
        {
          "property": "scale",
          "keyframes": [
            {
              "frame": 0,
              "value": 0.9
            },
            {
              "frame": 150,
              "value": 1.1,
              "easing": "drift"
            }
          ]
        },
        {
          "property": "x",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.width * 0.8)}}"
            },
            {
              "frame": 180,
              "value": "{{round(canvas.width * 0.7000000000000001)}}",
              "easing": "drift"
            }
          ]
        }
      ]
    },
    {
      "id": "glow2",
      "type": "circle",
      "x": "{{round(canvas.width * 0.19999999999999996)}}",
      "y": "{{round(canvas.height * 0.9)}}",
      "width": "{{round(min(canvas.width, canvas.height) * 0.8)}}",
      "fill": "{{accent2}}",
      "opacity": 0.072,
      "blur": 140,
      "animations": [
        {
          "property": "y",
          "keyframes": [
            {
              "frame": 0,
              "value": "{{round(canvas.height * 0.9)}}"
            },
            {
              "frame": 180,
              "value": "{{round(canvas.height * 0.8)}}",
              "easing": "drift"
            }
          ]
        },
        {
          "property": "scale",
          "keyframes": [
            {
              "frame": 0,
              "value": 1.1
            },
            {
              "frame": 150,
              "value": 0.9,
              "easing": "drift"
            }
          ]
        }
      ]
    },
    {
      "id": "stack",
      "type": "group",
      "x": "{{round(canvas.width * 0.08)}}",
      "y": 0,
      "width": "{{round(canvas.width * 0.84)}}",
      "height": "{{canvas.height}}",
      "layout": {
        "direction": "column",
        "gap": "{{round(min(canvas.width, canvas.height) * 0.012)}}",
        "align": "start",
        "justify": "center"
      },
      "children": [
        {
          "id": "number",
          "type": "text",
          "content": "{{number}}",
          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.26)}}",
          "color": "{{accent}}",
          "fontWeight": 900,
          "lineHeight": 0.9,
          "startFrame": 0,
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 14,
                  "value": 1,
                  "easing": "glide"
                }
              ]
            },
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 40,
                  "easing": "land"
                },
                {
                  "frame": 18,
                  "value": 0
                }
              ]
            }
          ]
        },
        {
          "id": "title",
          "type": "text",
          "content": "{{title}}",
          "fontSize": "{{round(min(canvas.width, canvas.height) * 0.075)}}",
          "color": "{{text}}",
          "fontWeight": "{{headWeight}}",
          "maxWidth": "{{round(canvas.width * 0.84)}}",
          "maxLines": 2,
          "minFontSize": "{{round(min(canvas.width, canvas.height) * 0.05)}}",
          "startFrame": 10,
          "animations": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 14,
                  "value": 1,
                  "easing": "glide"
                }
              ]
            },
            {
              "property": "y",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 28,
                  "easing": "land"
                },
                {
                  "frame": 18,
                  "value": 0
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sfx-hit",
      "type": "audio",
      "src": "sfx:thump",
      "startFrame": 0,
      "volume": 0.5
    }
  ],
  "scene": {
    "camera": {
      "animations": [
        {
          "property": "zoom",
          "keyframes": [
            {
              "frame": 0,
              "value": 1.08
            },
            {
              "frame": 75,
              "value": 1,
              "easing": "drift"
            }
          ]
        }
      ]
    }
  }
}
