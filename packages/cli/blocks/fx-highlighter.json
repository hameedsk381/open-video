{
  "id": "fx-highlighter",
  "name": "Highlighter sweep",
  "category": "effect",
  "kind": "overlay",
  "durationFrames": 90,
  "description": "A keyword in bold type with an accent highlight bar sweeping across behind it, left to right.",
  "params": {
    "word": {
      "type": "string",
      "default": "ENDLESS"
    }
  },
  "files": [
    "support/fx.bundle.js"
  ],
  "layers": [
    {
      "id": "highlight",
      "type": "react",
      "src": "fx.bundle.js",
      "width": "{{round(canvas.width * 0.92)}}",
      "height": "{{round(min(canvas.width, canvas.height) * 0.2)}}",
      "durationInFrames": 90,
      "props": {
        "effect": "highlight",
        "word": "{{word}}",
        "accent": "{{accent}}",
        "size": "{{round(min(canvas.width, canvas.height) * 0.11)}}"
      },
      "x": "{{round(canvas.width * 0.04)}}",
      "y": "{{round(canvas.height * 0.6)}}"
    },
    {
      "id": "sfx-1",
      "type": "audio",
      "src": "sfx:whoosh",
      "startFrame": 8,
      "volume": 0.35
    }
  ]
}
