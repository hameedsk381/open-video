        {
          "type": "code",
          "code": "const draw = function draw(ctx, { frame, width, height, api }) {\n    const rand = api.random(11);\n    for (let i = 0; i < 90; i++) {\n      const x0 = rand() * width, y0 = rand() * height, size = 2 + rand() * 5, phase = rand() * 10;\n      const drift = api.noise(x0 / 300, y0 / 300, frame / 90) * 60;\n      ctx.globalAlpha = 0.15 + 0.35 * api.noise(i, frame / 40, phase) ** 2 * 2;\n      ctx.fillStyle = i % 3 ? '#22d3ee' : '#a78bfa';\n      ctx.beginPath(); ctx.arc((x0 + drift + frame * 0.4) % width, y0 + drift * 0.5, size, 0, Math.PI * 2); ctx.fill();\n    }\n  };",
          "id": "field",
          "width": 1920,
          "height": 1080
        },
        {
          "type": "text",
          "content": "Write the video.",
          "x": 160,
          "y": 330,
          "fontSize": 150,
          "fontWeight": 800,
          "color": "#f5f7fb",
          "maxWidth": 1600,
          "split": {
