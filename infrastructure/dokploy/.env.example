# Set these in Dokploy's Environment tab for the Compose project.
POSTGRES_PASSWORD=change-me-a-long-random-string
REDIS_PASSWORD=change-me-another-long-random-string
# The https address Dokploy assigns (the domain you set in the Domains tab).
PUBLIC_ORIGIN=https://studio.example.com
# AI Provider keys (Groq, FreeLLMAPI, OpenAI)
GROQ_API_KEY=
FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=https://ai.hamathopc.in/v1
FREELLMAPI_MODEL=auto
# Optional
SIGNUPS=1
REQUIRE_VERIFIED=0
RENDER_TIMEOUT_SECONDS=900
AI_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=1

# S3 / Cloudflare R2 / MinIO Direct Upload
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# HMAC Webhooks (job.completed / job.failed)
WEBHOOK_URL=
WEBHOOK_SECRET=
