# Copy to .env (next to compose.yml) and fill in. Keep .env out of version control.
POSTGRES_PASSWORD=change-me-a-long-random-string
REDIS_PASSWORD=change-me-another-long-random-string
# The https address people use. Links in emails and the cookie rules follow it.
PUBLIC_ORIGIN=https://studio.example.com
# Your AI provider key, for the AI worker only.
# Optional
STUDIO_PORT=3100
SIGNUPS=1
REQUIRE_VERIFIED=0
RENDER_TIMEOUT_SECONDS=900
AI_TIMEOUT_SECONDS=300

# Worker Autoscaling & Concurrency
# Scale horizontally: `docker compose up --scale worker-render=8 -d`
WORKER_CONCURRENCY=1
AI_CONCURRENCY=1

# S3 / Cloudflare R2 / MinIO Direct Upload (Presigned CDN URLs)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# HMAC Webhooks (Dispatched on job.completed / job.failed)
# Headers: x-motionrender-signature: sha256=<hmac>, x-motionrender-event: job.completed
WEBHOOK_URL=
WEBHOOK_SECRET=

# Protects the AI keys people save in Settings (any long random string; keep it stable, or saved keys cannot be read). The service has no AI key of its own.
SETTINGS_SECRET=
