# Local development only. Copy to .env (git-ignored) and fill in what you need; nothing here is required to run the tests.
#
# The hosted service holds no AI key: people connect their own in Settings. The keys below are for the command line and the
# local studio on your own machine (`pnpm mr ai ...`, `pnpm mr ai studio`).

# One provider is enough. Groq is the default when its key is set.
GROQ_API_KEY=
# OVE_AI_PROVIDER=groq
# OVE_AI_MODEL=openai/gpt-oss-120b

# Optional: spread Groq calls over several models, or turn that off ("off").
# OVE_AI_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Optional: answer a rate-limited call with a second provider (it needs its own key set as well).
# OVE_AI_FALLBACK_PROVIDER=
