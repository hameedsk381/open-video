{
  "name": "open-video-engine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "ove": "tsx packages/cli/src/index.ts",
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:example": "tsx packages/cli/src/index.ts validate examples/typography/composition.json",
    "render:example": "tsx packages/cli/src/index.ts render examples/typography/composition.json --output artifacts/typography.mp4",
    "build:package": "tsx scripts/build-package.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
