{
  "name": "motionrender",
  "private": true,
  "type": "module",
  "version": "0.3.14",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "mr": "tsx packages/cli/src/index.ts",
    "motionrender": "tsx packages/cli/src/index.ts",
    "ove": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:example": "tsx packages/cli/src/index.ts validate examples/typography/composition.json",
    "render:example": "tsx packages/cli/src/index.ts render examples/typography/composition.json --output artifacts/typography.mp4",
    "build:studio": "pnpm --filter @ove/studio build",
    "dev:studio": "pnpm --filter @ove/studio dev",
    "build:package": "pnpm build:studio && tsx scripts/build-package.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:ai": "tsx scripts/eval-briefs.ts",
    "check:templates": "tsx scripts/check-templates.ts"
  },
  "devDependencies": {
    "@ove/ai": "workspace:*",
    "@ove/api": "workspace:*",
    "@ove/animation": "workspace:*",
    "@ove/assets": "workspace:*",
    "@ove/builder": "workspace:*",
    "@ove/contracts": "workspace:*",
    "@ove/core": "workspace:*",
    "@ove/ffmpeg": "workspace:*",
    "@ove/graphics": "workspace:*",
    "@ove/jobs": "workspace:*",
    "@ove/react": "workspace:*",
    "@ove/renderer": "workspace:*",
    "@ove/storage": "workspace:*",
    "@ove/worker": "workspace:*",
    "@ove/schema": "workspace:*",
    "@ove/timeline": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "react": "19",
    "react-dom": "19",
    "three": "0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
